/-
  **Genuine positive-mass path-prefix atoms of the interacting walk.**

  The existing "exact one-step laws" (`Swarm/StepCross.lean`) are stated on
  `historyEvent (actualHistory p m U n)`, which pins the used coordinates to their exact real
  values; by `Swarming.CurrentState.measure_actualHistory_eq_zero` those events are null for
  `n >= 1`, so those displays read `0 = 0` from time `1` on.  What the crossing argument
  actually needs is conditioning on the *letter* of each used coordinate (is the departure
  uniform below the current right probability?), not on its exact value, and the resulting
  events are the path-prefix atoms with positive mass.

  This file builds those atoms for the actual model, on the actual probability space
  `Swarming.Uniform.Array N` with `arrayMeasure N`:

  * `stepDir`, `letterBox p m U n`: the set of arrays whose departure letter at every time
    `t < n` and every walker agrees with the reference array `U`;
  * `letterBox_iff_path`: `letterBox` is exactly the path-prefix cylinder
    `{ω | ∀ k ≤ n, X_k(ω) = X_k(U)}` (a genuine if-and-only-if, both directions);
  * `pathPrefix`, `pathMeas`, `pathFilt`: the nested path filtration generated by the joint
    positions `X_0, …, X_n` of all walkers (position-adapted, monotone);
  * `measurableSet_letterBox`: the atoms are measurable.

  Everything here is deterministic or measurability-only; the conditional *law* on these atoms
  is in `CondLaw.lean`.
-/
import Swarm.Imports
import Swarm.StepCross
import Swarm.Reveal

namespace SwarmCross

open MeasureTheory Set
open Swarming Swarming.Model Swarming.Uniform Swarming.Trajectory
open Swarming.History Swarming.HistoryDeterminism Swarming.Transition
open scoped ENNReal BigOperators

variable {N : ℕ}

/-! ### The reference step direction -/

/-- Direction of the reference step of walker `i` at time `t`: `true` for a right step. -/
noncomputable def stepDir (p : ℝ) (m : ℕ) (U : Array N) (t : ℕ) (i : Fin N) : Bool :=
  decide ((trajectory p m U (t + 1)).pos i = (trajectory p m U t).pos i + 1)

lemma stepDir_true_iff {p : ℝ} {m : ℕ} {U : Array N} {t : ℕ} {i : Fin N} :
    stepDir p m U t i = true ↔ (trajectory p m U (t + 1)).pos i = (trajectory p m U t).pos i + 1 := by
  simp only [stepDir, decide_eq_true_eq]

lemma stepDir_false_iff {p : ℝ} {m : ℕ} {U : Array N} {t : ℕ} {i : Fin N} :
    stepDir p m U t i = false ↔ (trajectory p m U (t + 1)).pos i = (trajectory p m U t).pos i - 1 := by
  constructor
  · intro h
    have hnot : ¬ ((trajectory p m U (t + 1)).pos i = (trajectory p m U t).pos i + 1) := by
      intro hc
      have htrue : stepDir p m U t i = true := by rw [stepDir_true_iff]; exact hc
      rw [h] at htrue
      exact absurd htrue (by simp)
    rcases StepCross.pos_succ_eq_or p m U t i with hh | hh
    · exact absurd hh hnot
    · exact hh
  · intro h
    rw [stepDir, decide_eq_false_iff_not]
    omega

/-- The reference step, read back from its direction. -/
lemma pos_add_jumpShift_stepDir (p : ℝ) (m : ℕ) (U : Array N) (t : ℕ) (i : Fin N) :
    (trajectory p m U t).pos i + jumpShift (stepDir p m U t i) =
      (trajectory p m U (t + 1)).pos i := by
  rcases StepCross.pos_succ_eq_or p m U t i with h | h
  · rw [h]
    have htrue : stepDir p m U t i = true := by rw [stepDir_true_iff]; exact h
    rw [htrue]; simp [jumpShift]
  · rw [h]
    have hfalse : stepDir p m U t i = false := by rw [stepDir_false_iff]; exact h
    rw [hfalse]; simp [jumpShift]; omega

/-! ### The state is a function of the path -/

/-- The state at time `t` is a function of the positions at times `≤ t`. -/
lemma state_eq_of_path_eq (p : ℝ) (m : ℕ) (U ω : Array N) (t : ℕ)
    (h : ∀ j ≤ t, (trajectory p m ω j).pos = (trajectory p m U j).pos) :
    trajectory p m ω t = trajectory p m U t := by
  refine state_ext (h t le_rfl) ?_
  funext i x
  rw [ell_eq_localTime p m ω t, ell_eq_localTime p m U t]
  have hfil : (Finset.range (t + 1)).filter (fun k => (trajectory p m ω k).pos i = x) =
      (Finset.range (t + 1)).filter (fun k => (trajectory p m U k).pos i = x) := by
    apply Finset.filter_congr
    intro k hk
    rw [Finset.mem_range] at hk
    rw [congrFun (h k (by omega)) i]
  exact congrArg Finset.card hfil

lemma departureCoord_eq_of_state {p : ℝ} {m : ℕ} {U ω : Array N} {t : ℕ}
    (h : trajectory p m ω t = trajectory p m U t) :
    departureCoord p m ω t = departureCoord p m U t := by
  unfold departureCoord
  rw [h]

lemma currentAlpha_eq_of_state {p : ℝ} {m : ℕ} {U ω : Array N} {t : ℕ}
    (h : trajectory p m ω t = trajectory p m U t) :
    currentAlpha p m ω t = currentAlpha p m U t := by
  unfold currentAlpha
  rw [h]

/-! ### The letter box of a reference array -/

/-- The set of arrays which read the same departure *letter* as the reference array `U` at every
time `t < n` and every walker: at the departure coordinate of `U` the value lies in the jump set
that determined `U`'s own step.  Equivalently: the same joint path prefix (see
`letterBox_iff_path`). -/
noncomputable def letterBox (p : ℝ) (m : ℕ) (U : Array N) (n : ℕ) : Set (Array N) :=
  {ω | ∀ t < n, ∀ i : Fin N, ω (departureCoord p m U t i) ∈
    jumpSet (stepDir p m U t i) (currentAlpha p m U t i)}

lemma mem_letterBox {p : ℝ} {m : ℕ} {U ω : Array N} {n : ℕ} :
    ω ∈ letterBox p m U n ↔ ∀ t < n, ∀ i : Fin N, ω (departureCoord p m U t i) ∈
      jumpSet (stepDir p m U t i) (currentAlpha p m U t i) := Iff.rfl

/-- **The atoms are the path-prefix cylinders.**  The letter box of the reference array `U` is
exactly the set of arrays whose joint positions agree with `U`'s at every time `≤ n`. -/
theorem letterBox_iff_path (p : ℝ) (m : ℕ) (U : Array N) (n : ℕ) (ω : Array N) :
    ω ∈ letterBox p m U n ↔ ∀ k ≤ n, (trajectory p m ω k).pos = (trajectory p m U k).pos := by
  constructor
  · intro hω
    have key : ∀ k, k ≤ n → ∀ j ≤ k, (trajectory p m ω j).pos = (trajectory p m U j).pos := by
      intro k
      induction k with
      | zero =>
          intro _ j hj
          have hj0 : j = 0 := by omega
          subst hj0
          rfl
      | succ k ih =>
          intro hk j hj
          rcases Nat.lt_or_eq_of_le hj with hlt | heq
          · exact ih (by omega) j (by omega)
          · subst heq
            have hprev : ∀ j ≤ k, (trajectory p m ω j).pos = (trajectory p m U j).pos :=
              fun j hj => ih (by omega) j hj
            have hstate := state_eq_of_path_eq p m U ω k hprev
            have hα := currentAlpha_eq_of_state (m := m) hstate
            have hcoord := departureCoord_eq_of_state (m := m) hstate
            funext i
            have hmem := hω k (by omega) i
            rw [← hcoord, ← hα] at hmem
            have hstep := (nextPos_eq_iff p m ω k (fun _ => stepDir p m U k i) i).mpr hmem
            rw [trajectory_succ, nextWalkState_pos, trajectory_succ, nextWalkState_pos]
            rw [hstep, congrFun (hprev k le_rfl) i, pos_add_jumpShift_stepDir]
            rw [trajectory_succ, nextWalkState_pos]
    exact fun k hk => key k hk k le_rfl
  · intro h t ht i
    have hprev : ∀ j ≤ t, (trajectory p m ω j).pos = (trajectory p m U j).pos :=
      fun j hj => h j (by omega)
    have hstate := state_eq_of_path_eq p m U ω t hprev
    have hα := currentAlpha_eq_of_state (m := m) hstate
    have hcoord := departureCoord_eq_of_state (m := m) hstate
    have hstepω : (trajectory p m ω (t + 1)).pos i =
        (trajectory p m ω t).pos i + jumpShift (stepDir p m U t i) := by
      rw [h (t + 1) (by omega), ← pos_add_jumpShift_stepDir, congrFun (h t (by omega)) i]
    have hnext : Trajectory.nextPos p m ω (trajectory p m ω t) i =
        (trajectory p m ω t).pos i + jumpShift (stepDir p m U t i) := by
      rw [← hstepω, trajectory_succ, nextWalkState_pos]
    have hmain := (nextPos_eq_iff p m ω t (fun _ => stepDir p m U t i) i).mp hnext
    rw [hcoord, hα] at hmain
    exact hmain

lemma letterBox_eq_preimage_path (p : ℝ) (m : ℕ) (U : Array N) (n : ℕ) :
    letterBox p m U n =
      {ω : Array N | ∀ k ≤ n, (trajectory p m ω k).pos = (trajectory p m U k).pos} := by
  ext ω; exact letterBox_iff_path p m U n ω

/-! ### The path filtration -/

/-- The joint path prefix of all walkers up to time `n`. -/
noncomputable def pathPrefix (p : ℝ) (m : ℕ) (n : ℕ) : Array N → (Fin (n + 1) → Fin N → ℤ) :=
  fun ω k i => (trajectory p m ω (k : ℕ)).pos i

/-- **Preimages of path sets are measurable.**  The path prefix is a measurable map into the
countable path space: every fibre is a finite intersection of position equalities. -/
lemma measurableSet_pathPrefix_preimage (p : ℝ) (m : ℕ) (n : ℕ)
    (s : Set (Fin (n + 1) → Fin N → ℤ)) :
    MeasurableSet (pathPrefix (N := N) p m n ⁻¹' s) := by
  have heq : pathPrefix p m n ⁻¹' s = ⋃ q ∈ s, pathPrefix p m n ⁻¹' {q} := by
    ext ω
    simp only [mem_preimage, mem_iUnion, mem_ofPred_eq]
    exact ⟨fun h => ⟨pathPrefix p m n ω, h, rfl⟩, fun ⟨q, hq, hω⟩ => hω ▸ hq⟩
  rw [heq]
  refine MeasurableSet.biUnion (Set.to_countable s) (fun q _ => ?_)
  have hfib : pathPrefix p m n ⁻¹' {q} = ⋂ k : Fin (n + 1), ⋂ i : Fin N,
      {ω : Array N | (trajectory p m ω (k : ℕ)).pos i = q k i} := by
    ext ω
    simp only [pathPrefix, mem_preimage, mem_singleton_iff, mem_iInter, mem_ofPred_eq]
    constructor
    · intro h k i
      exact congrFun (congrFun h k) i
    · intro h
      funext k i
      exact h k i
  rw [hfib]
  exact MeasurableSet.iInter fun k => MeasurableSet.iInter fun i =>
    measurableSet_eq_fun ((Swarming.Fair.measurable_trajectory (N := N) p m (k : ℕ)).1 i)
      measurable_const

/-- The σ-algebra of the path prefix at time `n` (the discrete σ-algebra on the countable path
space). -/
noncomputable def pathMeas (p : ℝ) (m : ℕ) (n : ℕ) : MeasurableSpace (Array N) :=
  MeasurableSpace.comap (pathPrefix p m n) ⊤

lemma pathMeas_le (p : ℝ) (m : ℕ) (n : ℕ) :
    pathMeas p m n ≤ (inferInstance : MeasurableSpace (Array N)) := by
  intro s hs
  obtain ⟨t, -, rfl⟩ := hs
  exact measurableSet_pathPrefix_preimage p m n t

lemma pathMeas_mono (p : ℝ) (m : ℕ) : Monotone (pathMeas (N := N) p m) := by
  intro a b hab s hs
  obtain ⟨t, -, ht⟩ := hs
  refine ⟨{q : Fin (b + 1) → Fin N → ℤ | (fun k : Fin (a + 1) => q ⟨(k : ℕ), by omega⟩) ∈ t},
    trivial, ?_⟩
  rw [← ht]
  ext ω
  simp only [pathPrefix, mem_preimage, mem_ofPred_eq]
  rfl

/-- **The path filtration** of the interacting walk: `X_0, …, X_n` of all walkers. -/
noncomputable def pathFilt (p : ℝ) (m : ℕ) :
    Filtration ℕ (inferInstance : MeasurableSpace (Array N)) where
  seq n := pathMeas p m n
  mono' := pathMeas_mono p m
  le' := pathMeas_le p m

/-- A function of the path prefix is measurable for the path σ-algebra. -/
lemma measurable_pathMeas_comp (p : ℝ) (m : ℕ) (n : ℕ) {β : Type*} [MeasurableSpace β]
    (f : (Fin (n + 1) → Fin N → ℤ) → β) :
    Measurable[pathMeas p m n] (fun ω : Array N => f (pathPrefix p m n ω)) :=
  fun s _ => ⟨f ⁻¹' s, trivial, rfl⟩

lemma pos_adapted (p : ℝ) (m : ℕ) (i : Fin N) :
    ∀ n, Measurable[pathMeas p m n] (fun ω : Array N => (trajectory p m ω n).pos i) := by
  intro n
  have h := measurable_pathMeas_comp (N := N) p m n
    (fun q : Fin (n + 1) → Fin N → ℤ => q ⟨n, Nat.lt_succ_self n⟩ i)
  simpa only [pathPrefix] using h

lemma measurableSet_letterBox (p : ℝ) (m : ℕ) (U : Array N) (n : ℕ) :
    MeasurableSet (letterBox p m U n) := by
  have heq : letterBox p m U n = pathPrefix p m n ⁻¹'
      {q : Fin (n + 1) → Fin N → ℤ | ∀ k : Fin (n + 1),
        q k = (trajectory p m U (k : ℕ)).pos} := by
    ext ω
    rw [letterBox_iff_path]
    simp only [mem_preimage, mem_ofPred_eq]
    constructor
    · intro h k
      exact h (k : ℕ) (by omega)
    · intro h k hk
      exact h ⟨k, by omega⟩
  rw [heq]
  exact measurableSet_pathPrefix_preimage p m n _

end SwarmCross


