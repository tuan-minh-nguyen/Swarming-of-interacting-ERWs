/-
# Countable block independence for `Measure.infinitePi`

Let `μ` be a family of probability measures on one measurable space `α`, indexed by a
countable type `ι`, and let `P = Measure.infinitePi μ` be the product law on `ι → α`
(the exact measure used by `Swarming.Uniform.arrayMeasure`, which is
`Measure.infinitePi (fun _ => uniform01)` on `Fin N × ℤ × ℕ → ℝ`).

For two disjoint blocks `S`, `T` of the index set, the σ-algebras generated by the
coordinates in `S` and in `T` are independent under `P`.  This is the
"countable low/high independence" input of the paper's `(freshlaw)`.

The statement is reduced to Mathlib's `iIndepFun_infinitePi` and
`indep_iSup_of_disjoint`; the content of this file is the identification of the
block σ-algebra `⨆ i ∈ S, comap (eval i)` with the σ-algebra
`comap (S.domRestrict) pi` of functions that *only see* the block `S`.
-/
import Swarm.Imports

open MeasureTheory MeasurableSpace ProbabilityTheory

set_option warn.classDefReducibility false

namespace SwarmBlock

variable {ι : Type*} {α : Type*} [MeasurableSpace α]

/-- The coordinate σ-algebra generated by the coordinates in the block `S ⊆ ι`. -/
def blockSigma (S : Set ι) : MeasurableSpace (ι → α) :=
  ⨆ i ∈ S, MeasurableSpace.comap (fun f : ι → α => f i) ‹MeasurableSpace α›

/-- A single coordinate σ-algebra is coarser than the product σ-algebra. -/
theorem comap_eval_le_pi (i : ι) :
    MeasurableSpace.comap (fun f : ι → α => f i) ‹MeasurableSpace α› ≤
      MeasurableSpace.pi (X := fun _ : ι => α) :=
  le_iSup (fun i => MeasurableSpace.comap (fun f : ι → α => f i) ‹MeasurableSpace α›) i

/-- **The block σ-algebra is the σ-algebra of functions of the restricted coordinate.** -/
theorem blockSigma_eq (S : Set ι) :
    blockSigma (α := α) S =
      MeasurableSpace.comap (S.domRestrict) (MeasurableSpace.pi (X := fun _ : S => α)) := by
  rw [blockSigma, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp, Function.comp_def]
  exact iSup_subtype'

theorem blockSigma_le_pi (S : Set ι) :
    blockSigma (α := α) S ≤ MeasurableSpace.pi (X := fun _ : ι => α) :=
  iSup₂_le fun i _ => comap_eval_le_pi i

/-- The coordinate projections form an independent family under the product law. -/
theorem iIndep_coord [Countable ι] (μ : ι → Measure α) [∀ i, IsProbabilityMeasure (μ i)] :
    iIndep (fun i => MeasurableSpace.comap (fun f : ι → α => f i) ‹MeasurableSpace α›)
      (Measure.infinitePi μ) :=
  (iIndepFun_infinitePi (X := fun (_ : ι) (ω : α) => ω) (by fun_prop)).iIndep

/-- **Countable block independence.**  Disjoint blocks of coordinates are independent under the
infinite product law. -/
theorem block_indep [Countable ι] (μ : ι → Measure α) [∀ i, IsProbabilityMeasure (μ i)]
    {S T : Set ι} (hST : Disjoint S T) :
    Indep (blockSigma (α := α) S) (blockSigma (α := α) T) (Measure.infinitePi μ) :=
  indep_iSup_of_disjoint (fun i => comap_eval_le_pi i) (iIndep_coord μ) hST

/-- Independence of the two restricted σ-algebras, in restriction form. -/
theorem indep_restrict [Countable ι] (μ : ι → Measure α) [∀ i, IsProbabilityMeasure (μ i)]
    {S T : Set ι} (hST : Disjoint S T) :
    Indep (MeasurableSpace.comap (S.domRestrict) (MeasurableSpace.pi (X := fun _ : S => α)))
      (MeasurableSpace.comap (T.domRestrict) (MeasurableSpace.pi (X := fun _ : T => α)))
      (Measure.infinitePi μ) := by
  have h := block_indep μ hST
  rwa [blockSigma_eq, blockSigma_eq] at h

/-- **Block factorization.**  For measurable sets `A` of the `S`-coordinates and `B` of the
`T`-coordinates, the product law factorises over the two blocks. -/
theorem block_measure_inter [Countable ι] (μ : ι → Measure α) [∀ i, IsProbabilityMeasure (μ i)]
    {S T : Set ι} (hST : Disjoint S T) {A : Set (S → α)} {B : Set (T → α)}
    (hA : MeasurableSet A) (hB : MeasurableSet B) :
    (Measure.infinitePi μ) (S.domRestrict ⁻¹' A ∩ T.domRestrict ⁻¹' B)
      = (Measure.infinitePi μ) (S.domRestrict ⁻¹' A)
        * (Measure.infinitePi μ) (T.domRestrict ⁻¹' B) :=
  (Indep_iff _ _ _).mp (indep_restrict μ hST) _ _
    (measurableSet_comap.mpr ⟨A, hA, rfl⟩) (measurableSet_comap.mpr ⟨B, hB, rfl⟩)

end SwarmBlock
