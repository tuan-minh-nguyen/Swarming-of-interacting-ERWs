/-
  **Finite fresh-coordinate laws on every enlarged-filtration piece.**

  This is the generating box law used above a running record.  On a piece `prefAgree γ`, a set
  `B` measurable in the revealed prefix is independent of every injective finite family of
  coordinates avoiding `prefRead n γ`.  No global independence of the future array from the past
  is assumed: the independence is precisely over the finite fresh family.
-/
import Swarm.EnlFilt
import Swarm.EnlLaw
import Swarm.FreshIndependence
import Swarm.UniformArray
import Swarm.Reveal
import Swarm.BadCarrier

open MeasureTheory ProbabilityTheory
open scoped ENNReal BigOperators

namespace Swarming.Enl

open Swarming.Model Swarming.Uniform Swarming.Trajectory

variable {N : ℕ}

/-- **Finite fresh-coordinate law on one enlarged-filtration piece.**  On the piece `{path=γ}`,
the events generated by an injective family avoiding `prefRead` have product uniform law and are
independent of every revealed-prefix event `B`. -/
theorem enl_fresh_future_piece (p : ℝ) (m : ℕ) (n : ℕ) (γ : Pref N n)
    {B : Set (Array N)} (hB : MeasurableSet[cylAt (N := N) (prefRead n γ)] B)
    {ι : Type*} [Fintype ι] (α : ι → Fin N × ℤ × ℕ) (hαinj : Function.Injective α)
    (hfresh : ∀ i, α i ∉ prefRead n γ) (I : ι → Set ℝ) (hI : ∀ i, MeasurableSet (I i)) :
    arrayMeasure N (prefAgree p m γ ∩ B ∩ ⋂ i, {U : Array N | U (α i) ∈ I i}) =
      (∏ i, uniform01 (I i)) * arrayMeasure N (prefAgree p m γ ∩ B) := by
  classical
  obtain ⟨Bs, hBs, hBeq⟩ := MeasurableSpace.measurableSet_comap.1 hB
  set A : Set (prefRead n γ → ℝ) :=
    {g : prefRead n γ → ℝ | ∀ t : Fin (n + 1),
        (trajectory p m (extendArr g) t.1).pos = γ t} ∩ Bs with hA
  have hAmeas : MeasurableSet A :=
    (measurableSet_prefRead_preimage p m γ).inter hBs
  have hbase : prefAgree p m γ ∩ B =
      (fun U (c : prefRead n γ) => U c) ⁻¹' A := by
    rw [← hBeq]
    ext U
    rw [prefAgree_preimage p m γ]
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_setOf_eq, hA]
  have hfull : prefAgree p m γ ∩ B ∩ ⋂ i, {U : Array N | U (α i) ∈ I i} =
      (fun U (c : prefRead n γ) => U c) ⁻¹' A ∩
        ⋂ i, (fun U : Array N => U (α i)) ⁻¹' I i := by
    rw [hbase]
    ext U
    simp only [Set.mem_inter_iff, Set.mem_iInter, Set.mem_setOf_eq, Set.mem_preimage]
  have hind := SwarmIID.indep_fresh_finset (μ := arrayMeasure N) (array_independent N)
    (fun c => measurable_pi_apply c) hαinj hfresh A hAmeas I hI
  have hprod : ∀ i, arrayMeasure N ((fun U : Array N => U (α i)) ⁻¹' I i) =
      uniform01 (I i) := fun i => arrayMeasure_preimage_set N (α i) (I i) (hI i)
  rw [hfull, hind, hbase]
  simp only [hprod]
  rw [mul_comm]

/-- Above an upper bound for walker `j` on the entire prefix, its coordinates never appear in
`prefRead`.  Visit numbers are irrelevant: the position equality already contradicts freshness. -/
lemma notMem_prefRead_of_le {n : ℕ} (γ : Pref N n) (j : Fin N) (r x : ℤ)
    (hbound : ∀ t : Fin (n + 1), γ t j ≤ r) (hx : r < x) (k : ℕ) :
    (j, x, k) ∉ prefRead n γ := by
  rw [mem_prefRead]
  rintro ⟨t, ht, hpos, -⟩
  have hle := hbound ⟨t, by omega⟩
  rw [ext_of_lt _ (by omega) j] at hpos
  omega

/-- The future above the actual running maximum is unread.  On a prefixed piece, the record
is the supremum of exactly the same positions used in `prefRead`, so every coordinate strictly
above it avoids the revealed set. -/
lemma notMem_prefRead_above_runMax (p : ℝ) (m : ℕ) {n : ℕ} {γ : Pref N n} {U : Array N}
    (hU : U ∈ prefAgree p m γ) (j : Fin N) {x : ℤ} (hx : runMax p m U j n < x) (k : ℕ) :
    (j, x, k) ∉ prefRead n γ := by
  exact notMem_prefRead_of_le (x := x) γ j (runMax p m U j n) (fun t => by
    have heq := (ext_prefOf_of_mem (s := (t : ℕ)) hU (Nat.lt_succ_iff.mp t.2) j).symm
    rw [ext_of_lt γ (by omega) j] at heq
    rw [← heq]
    have hmono : runMax p m U j (t : ℕ) ≤ runMax p m U j n :=
      Swarming.Trajectory.runMax_mono p m U j (Nat.le_of_lt_succ t.2)
    exact le_trans (Swarming.Trajectory.le_runMax p m U j t.1) hmono) hx k

/-- The site-mark box at a site above the record has its exact Bernoulli conditional law. -/
theorem enl_fresh_siteMark_piece (p : ℝ) (hp0 : 0 < p) (hp1 : p < 1) (m : ℕ) {n : ℕ}
    (γ : Pref N n) {B : Set (Array N)}
    (hB : MeasurableSet[cylAt (N := N) (prefRead n γ)] B)
    {U : Array N} (hU : U ∈ prefAgree p m γ) (j : Fin N) {x : ℤ}
    (hx : runMax p m U j n < x) :
    arrayMeasure N (prefAgree p m γ ∩ B ∩ {V : Array N | SiteMark p m V j x}) =
      (ENNReal.ofReal (1 - p)) ^ (m - 1) * arrayMeasure N (prefAgree p m γ ∩ B) := by
  have hbase := enl_fresh_future_piece p m n γ hB
    (α := fun k : ↥(Finset.Icc 1 (m - 1)) => (j, x, k.1))
    (by
      intro a b hab
      have hv := congrArg (fun c : Fin N × ℤ × ℕ => c.2.2) hab
      exact Subtype.ext hv)
    (fun c => notMem_prefRead_above_runMax p m hU j hx c.1)
    (fun _ => Set.Ioi p) (fun _ => measurableSet_Ioi)
  have hset : prefAgree p m γ ∩ B ∩ {V : Array N | SiteMark p m V j x} =
      prefAgree p m γ ∩ B ∩ ⋂ k : ↥(Finset.Icc 1 (m - 1)),
        {V : Array N | V (j, x, k.1) ∈ Set.Ioi p} := by
    ext V
    simp only [Set.mem_inter_iff, SiteMark, Set.mem_setOf_eq, Set.mem_iInter, Set.mem_Ioi]
    constructor
    · rintro ⟨⟨hγ, hBmem⟩, hmark⟩
      exact ⟨⟨hγ, hBmem⟩, fun c => hmark c.1 c.2⟩
    · rintro ⟨⟨hγ, hBmem⟩, hmark⟩
      exact ⟨⟨hγ, hBmem⟩, fun k hk => hmark ⟨k, hk⟩⟩
  rw [hset, hbase]
  simp [uniform01_Ioi hp0 hp1]

/-- Ambient measurability of one site-mark event, without any revelation hypothesis. -/
lemma measurableSet_siteMark_array (p : ℝ) (m : ℕ) (j : Fin N) (x : ℤ) :
    MeasurableSet {U : Array N | SiteMark p m U j x} := by
  have hset : {U : Array N | SiteMark p m U j x} = ⋂ k ∈ Finset.Icc 1 (m - 1),
      {U : Array N | U (j, x, k) ∈ Set.Ioi p} := by
    ext U
    simp only [SiteMark, Set.mem_setOf_eq, Set.mem_iInter, Set.mem_Ioi]
  rw [hset]
  exact Finset.measurableSet_biInter _ (fun k _ =>
    measurableSet_Ioi.preimage (measurable_pi_apply (j, x, k)))

/-- **Measure-real conditional mass at one fresh site above the record.** -/
theorem enl_setIntegral_siteMark_above_runMax (p : ℝ) (hp0 : 0 < p) (hp1 : p < 1)
    (m : ℕ) {n : ℕ} {A : Set (Array N)} (hA : MeasurableSet[enlFilt p m n] A)
    (j : Fin N) (x : ℤ) (hAx : A ⊆ {U : Array N | runMax p m U j n < x}) :
    (arrayMeasure N).real (A ∩ {U : Array N | SiteMark p m U j x}) =
      (1 - p) ^ (m - 1) * (arrayMeasure N).real A := by
  classical
  have hprob : IsProbabilityMeasure (arrayMeasure N) := arrayMeasure_isProbabilityMeasure N
  have hAn : MeasurableSet[enlMeas p m n] A := hA
  choose B hB hEq using hAn
  have hbase : ∀ γ : Pref N n, MeasurableSet (prefAgree p m γ ∩ B γ) := by
    intro γ
    exact (measurableSet_prefAgree_ambient p m γ).inter (measurableSet_of_cyl (hB γ))
  have hGunion : A = ⋃ γ : Pref N n, prefAgree p m γ ∩ B γ := by
    ext U
    simp only [Set.mem_iUnion, Set.mem_inter_iff]
    constructor
    · intro h
      refine ⟨prefOf p m n U, prefAgree_prefOf U, ?_⟩
      have hh : U ∈ prefAgree p m (prefOf p m n U) ∩ A := ⟨prefAgree_prefOf U, h⟩
      rw [hEq (prefOf p m n U)] at hh
      exact hh.2
    · rintro ⟨γ, h1, h2⟩
      have hh : U ∈ prefAgree p m γ ∩ A := by rw [hEq γ]; exact ⟨h1, h2⟩
      exact hh.2
  have hdisj : Pairwise (fun γ γ' : Pref N n =>
      Disjoint (prefAgree p m γ ∩ B γ) (prefAgree p m γ' ∩ B γ')) := by
    intro γ γ' hne
    rw [Set.disjoint_left]
    rintro U ⟨h1, -⟩ ⟨h2, -⟩
    exact hne (by funext t; rw [← h1 t, ← h2 t])
  have hdisjMark : Pairwise (fun γ γ' : Pref N n =>
      Disjoint ((prefAgree p m γ ∩ B γ) ∩ {U : Array N | SiteMark p m U j x})
        ((prefAgree p m γ' ∩ B γ') ∩ {U : Array N | SiteMark p m U j x})) := by
    intro γ γ' hne
    exact (hdisj hne).mono Set.inter_subset_left Set.inter_subset_left
  have hmark : ∀ γ : Pref N n,
      arrayMeasure N ((prefAgree p m γ ∩ B γ) ∩ {U : Array N | SiteMark p m U j x}) =
        (ENNReal.ofReal (1 - p)) ^ (m - 1) * arrayMeasure N (prefAgree p m γ ∩ B γ) := by
    intro γ
    by_cases hpref : prefAgree p m γ ∩ B γ = ∅
    · simp [hpref]
    · obtain ⟨V, hV⟩ := Set.nonempty_iff_ne_empty.mpr hpref
      have hVA : V ∈ A := by
        have hh : V ∈ prefAgree p m γ ∩ A := by rw [hEq γ]; exact hV
        exact hh.2
      have hxV : runMax p m V j n < x := hAx hVA
      have h := enl_fresh_siteMark_piece (N := N) p hp0 hp1 m γ (hB γ)
        (U := V) hV.1 j hxV
      simpa only [Set.inter_assoc] using h
  have hlhs : arrayMeasure N (A ∩ {U : Array N | SiteMark p m U j x}) =
      ∑' γ : Pref N n, (ENNReal.ofReal (1 - p)) ^ (m - 1) * arrayMeasure N (prefAgree p m γ ∩ B γ) := by
    have hunion : A ∩ {U : Array N | SiteMark p m U j x} = ⋃ γ : Pref N n,
        (prefAgree p m γ ∩ B γ) ∩ {U : Array N | SiteMark p m U j x} := by
      conv_lhs => rw [hGunion]
      rw [Set.iUnion_inter]
    rw [hunion, measure_iUnion hdisjMark (fun γ =>
      (hbase γ).inter (measurableSet_siteMark_array p m j x))]
    exact tsum_congr hmark
  have hreal : arrayMeasure N (A ∩ {U : Array N | SiteMark p m U j x}) =
      (ENNReal.ofReal (1 - p)) ^ (m - 1) * arrayMeasure N A := by
    rw [hlhs, ENNReal.tsum_mul_left]
    rw [← measure_iUnion hdisj hbase, hGunion]
  have hreal' : ENNReal.toReal (arrayMeasure N (A ∩ {U : Array N | SiteMark p m U j x})) =
      ENNReal.toReal ((ENNReal.ofReal (1 - p)) ^ (m - 1) * arrayMeasure N A) :=
    congrArg ENNReal.toReal hreal
  calc
    (arrayMeasure N).real (A ∩ {U : Array N | SiteMark p m U j x}) =
        ENNReal.toReal (arrayMeasure N (A ∩ {U : Array N | SiteMark p m U j x})) := rfl
    _ = ((ENNReal.ofReal (1 - p)) ^ (m - 1) * arrayMeasure N A).toReal := hreal'
    _ = (1 - p) ^ (m - 1) * (arrayMeasure N).real A := by
      have hnonneg : 0 ≤ 1 - p := by linarith
      rw [ENNReal.toReal_mul, ← ENNReal.ofReal_pow hnonneg,
        ENNReal.toReal_ofReal (pow_nonneg hnonneg _)]
      rfl

/-- The strict upper-record event is measurable for the enlarged filtration. -/
lemma measurableSet_runMax_lt_enl (p : ℝ) (m : ℕ) (j : Fin N) (n : ℕ) (x : ℤ) :
    MeasurableSet[enlFilt p m n] {U : Array N | runMax p m U j n < x} := by
  classical
  have hset : {U : Array N | runMax p m U j n < x} =
      ⋂ t ∈ Finset.range (n + 1),
        {U : Array N | (trajectory p m U t).pos j < x} := by
    ext U
    simp only [Set.mem_setOf_eq, Set.mem_iInter, Finset.mem_range]
    constructor
    · intro h t ht
      exact lt_of_le_of_lt ((Swarming.Trajectory.le_runMax p m U j t).trans
        (Swarming.Trajectory.runMax_mono p m U j (by omega))) h
    · intro h
      obtain ⟨t, ht, heq⟩ := Swarming.Trajectory.exists_eq_runMax p m U j n
      calc
        runMax p m U j n = (trajectory p m U t).pos j := heq.symm
        _ < x := h t (by omega)
  rw [hset]
  exact Finset.measurableSet_biInter _ (fun t ht =>
    enl_pos_measurable p m n (Nat.lt_succ_iff.mp (Finset.mem_range.mp ht)) j measurableSet_Iio)

/-- **Conditional fresh-site law on the above-record event.**  On the enlarged-filtration event
`R = {runMax < x}`, the site-mark indicator has conditional expectation the constant
`(1-p)^(m-1)`, multiplied by the indicator of `R`.  The indicator of `R` is essential: no
constant conditional law is asserted on paths which have already reached `x`. -/
theorem condExp_siteMark_above_runMax (p : ℝ) (hp0 : 0 < p) (hp1 : p < 1)
    (m : ℕ) (n : ℕ) (j : Fin N) (x : ℤ) :
    let R : Set (Array N) := {U | runMax p m U j n < x}
    let S : Set (Array N) := {U | SiteMark p m U j x}
    (arrayMeasure N)[R.indicator (S.indicator fun _ => (1 : ℝ)) | enlFilt p m n]
      =ᵐ[arrayMeasure N] R.indicator (fun _ => (1 - p) ^ (m - 1)) := by
  classical
  dsimp only
  let μ := arrayMeasure N
  let R : Set (Array N) := {U | runMax p m U j n < x}
  let S : Set (Array N) := {U | SiteMark p m U j x}
  have hprob : IsProbabilityMeasure μ := arrayMeasure_isProbabilityMeasure N
  have hle : enlFilt p m n ≤ (inferInstance : MeasurableSpace (Array N)) := (enlFilt p m).le n
  have hsig : SigmaFinite (μ.trim hle) := inferInstance
  have hR : MeasurableSet[enlFilt p m n] R := measurableSet_runMax_lt_enl p m j n x
  have hR0 : MeasurableSet R := hle R hR
  have hS0 : MeasurableSet S := measurableSet_siteMark_array p m j x
  have hq0 : 0 ≤ (1 - p) ^ (m - 1) := pow_nonneg (by linarith) _
  have hq1 : (1 - p) ^ (m - 1) ≤ 1 := pow_le_one₀ (by linarith) (by linarith)
  have hind_int : Integrable (R.indicator (S.indicator fun _ => (1 : ℝ))) μ := by
    refine Integrable.mono' (integrable_const (1 : ℝ))
      (((measurable_const.indicator hS0).indicator hR0).aestronglyMeasurable) ?_
    filter_upwards with U
    by_cases hU : U ∈ R
    · by_cases hmark : U ∈ S
      · rw [Set.indicator_of_mem hU, Set.indicator_of_mem hmark, Real.norm_eq_abs, abs_one]
      · rw [Set.indicator_of_mem hU, Set.indicator_of_notMem hmark]
        simp
    · rw [Set.indicator_of_notMem hU]
      simp
  refine (ae_eq_condExp_of_forall_setIntegral_eq hle hind_int ?_ ?_
    ((measurable_const.indicator hR).aestronglyMeasurable)).symm
  · intro s hs hfin
    exact ((integrable_const (1 : ℝ)).mono'
      (measurable_const.indicator hR0).aestronglyMeasurable
      (Filter.Eventually.of_forall fun U => by
        by_cases hU : U ∈ R
        · rw [Set.indicator_of_mem hU, Real.norm_eq_abs, abs_of_nonneg hq0]
          exact hq1
        · rw [Set.indicator_of_notMem hU]
          simp)).integrableOn
  · intro s hs hfin
    have hs0 : MeasurableSet s := hle s hs
    have hsr : MeasurableSet (s ∩ R) := hs0.inter hR0
    have hleft : ∫ U in s, R.indicator (S.indicator fun _ => (1 : ℝ)) U ∂μ =
        μ.real ((s ∩ R) ∩ S) := by
      rw [← integral_indicator (μ := μ) hs0]
      have hcongr : ∫ U, s.indicator (R.indicator (S.indicator fun _ => (1 : ℝ))) U ∂μ =
          ∫ U, ((s ∩ R) ∩ S).indicator (fun _ => (1 : ℝ)) U ∂μ := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
        by_cases hU : U ∈ s
        · by_cases hr : U ∈ R
          · by_cases hm : U ∈ S
            · rw [Set.indicator_of_mem hU, Set.indicator_of_mem hr, Set.indicator_of_mem hm,
                Set.indicator_of_mem (Set.mem_inter (Set.mem_inter hU hr) hm)]
            · rw [Set.indicator_of_mem hU, Set.indicator_of_mem hr, Set.indicator_of_notMem hm,
                Set.indicator_of_notMem (fun h => hm h.2)]
          · rw [Set.indicator_of_mem hU, Set.indicator_of_notMem hr,
              Set.indicator_of_notMem (fun h => hr h.1.2)]
        · rw [Set.indicator_of_notMem hU,
            Set.indicator_of_notMem (fun h => hU h.1.1)]
      rw [hcongr]
      exact integral_indicator_one (μ := μ) (hsr.inter hS0)
    have hright : ∫ U in s, R.indicator (fun _ => (1 - p) ^ (m - 1)) U ∂μ =
        (1 - p) ^ (m - 1) * μ.real (s ∩ R) := by
      rw [← integral_indicator (μ := μ) hs0]
      have hcongr : ∫ U, s.indicator (R.indicator (fun _ => (1 - p) ^ (m - 1))) U ∂μ =
          ∫ U, (s ∩ R).indicator (fun _ => (1 - p) ^ (m - 1)) U ∂μ := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
        by_cases hU : U ∈ s
        · by_cases hr : U ∈ R
          · rw [Set.indicator_of_mem hU, Set.indicator_of_mem hr,
              Set.indicator_of_mem (Set.mem_inter hU hr)]
          · rw [Set.indicator_of_mem hU, Set.indicator_of_notMem hr,
              Set.indicator_of_notMem (fun h => hr h.2)]
        · rw [Set.indicator_of_notMem hU,
            Set.indicator_of_notMem (fun h => hU h.1)]
      rw [hcongr, integral_indicator hsr, setIntegral_const, smul_eq_mul, mul_comm]
    rw [hright, hleft]
    exact (enl_setIntegral_siteMark_above_runMax p hp0 hp1 m (hs.inter hR)
      j x Set.inter_subset_right).symm

end Swarming.Enl


