/-
# General finite enriched futures and their actual record-word expansion

For arbitrary `K ≤ n`, this module expresses the mass of the canonical raw-time window
`finStrict K ∩ pathPat n ⁻¹' C` through the canonical finite-future kernel after every earlier
record prefix. The prefix includes the whole observed enriched history, while its next kernel
reads only the last endpoint state. No stationarity, invariance of the initial law, conditional
regular-distribution instance, or record-time/raw-time coincidence is assumed.

The second main identity expands the next enriched record as a sum over every duration `k` and
every word `q : Fin k → JumpVec N`, retaining `hitW`, `segOf`, and the capped endpoint
`RecKernel.out`. The raw event is still evaluated by `prefixPath`; it can end inside a segment.
-/
import Swarm.ChainFiniteFutureKernel

open MeasureTheory Set ProbabilityTheory
open scoped ENNReal BigOperators
open SimJump

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

namespace SwarmGeneralFuture

attribute [local instance] Classical.propDecidable

variable {N m : ℕ}

/-! ## Canonical finite futures of an arbitrary trajectory law -/

/-- The `Iic n` marginal of a canonical trajectory is the initial atom followed by the canonical
future kernel. -/
theorem trajMeasure_map_frestrictLe_eq_comp
    {X : Type*} [MeasurableSpace X]
    (κ : (n : ℕ) → Kernel (Π _i : Finset.Iic n, X) X)
    [∀ n, IsMarkovKernel (κ n)] (μ₀ : Measure X) [IsProbabilityMeasure μ₀] (n : ℕ) :
    (Kernel.trajMeasure (X := fun _ => X) μ₀ κ).map (Preorder.frestrictLe (π := fun _ => X) n) =
      (Kernel.partialTraj (X := fun _ => X) κ 0 n) ∘ₘ
        (μ₀.map (MeasurableEquiv.piUnique (fun _ : Finset.Iic 0 => X)).symm) := by
  rw [Kernel.trajMeasure, Measure.map_comp _ _ (by fun_prop),
    Kernel.traj_map_frestrictLe]

/-- **General finite-future marginal factorisation.** -/
theorem trajMeasure_map_frestrictLe_eq_bind
    {X : Type*} [MeasurableSpace X]
    (κ : (n : ℕ) → Kernel (Π _i : Finset.Iic n, X) X)
    [∀ n, IsMarkovKernel (κ n)] (μ₀ : Measure X) [IsProbabilityMeasure μ₀]
    {r n : ℕ} (hrn : r ≤ n) :
    (Kernel.trajMeasure (X := fun _ => X) μ₀ κ).map (Preorder.frestrictLe (π := fun _ => X) n) =
      ((Kernel.trajMeasure (X := fun _ => X) μ₀ κ).map (Preorder.frestrictLe (π := fun _ => X) r)).bind
        (fun v => Kernel.partialTraj (X := fun _ => X) κ r n v) := by
  rw [trajMeasure_map_frestrictLe_eq_comp κ μ₀ n,
    trajMeasure_map_frestrictLe_eq_comp κ μ₀ r]
  rw [Measure.comp_assoc, Kernel.partialTraj_comp_partialTraj (Nat.zero_le r) hrn]

/-- The actual enriched path has the same factorisation for every initial record-state law. -/
theorem infLaw_prefix_eq_bind (p : ℝ) (hm : 1 ≤ m)
    (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1)
    (π : Measure (SwarmRec.RecState N m)) [IsProbabilityMeasure π]
    {r n : ℕ} (hrn : r ≤ n) :
    ((SwarmInfSeg.infLaw (N := N) (m := m) p hm hp hp1 π).map
        (Preorder.frestrictLe (π := fun _ => SwarmInfSeg.Pair N m) n)) =
      (((SwarmInfSeg.infLaw (N := N) (m := m) p hm hp hp1 π).map
        (Preorder.frestrictLe (π := fun _ => SwarmInfSeg.Pair N m) r)).bind
          (fun v => Kernel.partialTraj (X := fun _ => SwarmInfSeg.Pair N m) (SwarmInfSeg.homK (N := N) (m := m) p hm) r n v)) := by
  letI hKall : ∀ n, IsMarkovKernel (SwarmInfSeg.homK (N := N) (m := m) p hm n) :=
    SwarmInfSeg.isMarkovKernel_homK p hm hp hp1
  letI hπ : IsProbabilityMeasure (SwarmSegKernel.pairLaw (N := N) (m := m) p hm π) :=
    SwarmInfSeg.isProbabilityMeasure_pairLaw p hm hp hp1 π
  exact trajMeasure_map_frestrictLe_eq_bind
    (SwarmInfSeg.homK (N := N) (m := m) p hm) _ hrn

/-- **Arbitrary raw window, arbitrary finite enriched future.** -/
theorem chainLaw_window_eq_partialTraj (p : ℝ) (hm : 1 ≤ m)
    (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1)
    (π : Measure (SwarmRec.RecState N m)) [IsProbabilityMeasure π]
    {K r n : ℕ} (hK : K ≤ n) (hrn : r ≤ n)
    {C : Set (Fin (n + 1) → Fin N → ℤ)} (hC : MeasurableSet C) :
    SwarmChainAssemble.chainLaw
        (SwarmInfSeg.infLaw (N := N) (m := m) p hm hp hp1 π)
        (SwarmFinFuture.chainWindow K n C) =
      ∫⁻ v : SwarmFinFuture.Prefix (N := N) (m := m) r,
        (Kernel.partialTraj (X := fun _ => SwarmInfSeg.Pair N m) (SwarmInfSeg.homK (N := N) (m := m) p hm) r n v)
          (SwarmFinFuture.prefixWindow K n C)
        ∂((SwarmInfSeg.infLaw (N := N) (m := m) p hm hp hp1 π).map
          (Preorder.frestrictLe (π := fun _ => SwarmInfSeg.Pair N m) r)) := by
  rw [SwarmFinFuture.chainLaw_window_eq_prefix p hm hp hp1 π hK hC,
    infLaw_prefix_eq_bind p hm hp hp1 π hrn,
    Measure.bind_apply (SwarmFinFuture.measurableSet_prefixWindow hC) (Kernel.aemeasurable _)]

/-! ## The one-record future in durations, words, and actual endpoints -/

/-- Append the record generated by a duration/word pair from the endpoint of `v`. -/
noncomputable def prefixNext (_p : ℝ) (hm : 1 ≤ m) {r : ℕ}
    (v : SwarmFinFuture.Prefix (N := N) (m := m) r)
    (pq : (k : ℕ) × (Fin k → JumpVec N)) :
    SwarmFinFuture.Prefix (N := N) (m := m) (r + 1) :=
  SwarmFinFuture.prefixSnoc v
    (SwarmSegKernel.segOf (v ⟨r, Finset.mem_Iic.2 le_rfl⟩).2 pq.1 pq.2,
      RecKernel.out hm pq.2 (v ⟨r, Finset.mem_Iic.2 le_rfl⟩).2)

/-- The next-record section is an explicit weighted sum. -/
theorem pairK_prefix_section_eq_tsum (p : ℝ) (hm : 1 ≤ m) {r : ℕ}
    (v : SwarmFinFuture.Prefix (N := N) (m := m) r)
    {E : Set (SwarmFinFuture.Prefix (N := N) (m := m) (r + 1))}
    (hE : MeasurableSet E) :
    (SwarmSegKernel.pairK (N := N) (m := m) p hm
        (v ⟨r, Finset.mem_Iic.2 le_rfl⟩))
        {a | SwarmFinFuture.prefixSnoc v a ∈ E} =
      ∑' pq : (k : ℕ) × (Fin k → JumpVec N),
        ENNReal.ofReal (RecKernel.hitW p pq.2
          (v ⟨r, Finset.mem_Iic.2 le_rfl⟩).2) *
          (if prefixNext p hm v pq ∈ E then 1 else 0) := by
  have hsec : MeasurableSet {a : SwarmInfSeg.Pair N m |
      SwarmFinFuture.prefixSnoc v a ∈ E} := hE.preimage
    (SwarmFinFuture.measurable_prefixSnoc.comp (measurable_const.prodMk measurable_id))
  rw [SwarmSegKernel.pairK_apply, SwarmSegKernel.asegK_apply p hm _ hsec]
  rfl

/-- **General one-record `hitW` recursion for every raw window.** -/
theorem infLaw_prefix_succ_apply_hitW (p : ℝ) (hm : 1 ≤ m)
    (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1)
    (π : Measure (SwarmRec.RecState N m)) [IsProbabilityMeasure π]
    {r : ℕ} {E : Set (SwarmFinFuture.Prefix (N := N) (m := m) (r + 1))}
    (hE : MeasurableSet E) :
    ((SwarmInfSeg.infLaw (N := N) (m := m) p hm hp hp1 π).map
        (Preorder.frestrictLe (π := fun _ => SwarmInfSeg.Pair N m) (r + 1))) E =
      ∫⁻ v : SwarmFinFuture.Prefix (N := N) (m := m) r,
        (∑' pq : (k : ℕ) × (Fin k → JumpVec N),
          ENNReal.ofReal (RecKernel.hitW p pq.2
            (v ⟨r, Finset.mem_Iic.2 le_rfl⟩).2) *
            (if prefixNext p hm v pq ∈ E then 1 else 0))
        ∂((SwarmInfSeg.infLaw (N := N) (m := m) p hm hp hp1 π).map
          (Preorder.frestrictLe (π := fun _ => SwarmInfSeg.Pair N m) r)) := by
  rw [SwarmFinFuture.infLaw_prefix_succ_apply p hm hp hp1 π hE]
  exact lintegral_congr fun v => pairK_prefix_section_eq_tsum p hm v hE

/-- **Arbitrary `K`, arbitrary raw width `r+1 ≥ K`, arbitrary measurable `C`.** -/
theorem chainLaw_window_eq_hitW_succ (p : ℝ) (hm : 1 ≤ m)
    (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1)
    (π : Measure (SwarmRec.RecState N m)) [IsProbabilityMeasure π]
    {K r : ℕ} (hK : K ≤ r + 1)
    {C : Set (Fin (r + 1 + 1) → Fin N → ℤ)} (hC : MeasurableSet C) :
    SwarmChainAssemble.chainLaw
        (SwarmInfSeg.infLaw (N := N) (m := m) p hm hp hp1 π)
        (SwarmFinFuture.chainWindow K (r + 1) C) =
      ∫⁻ v : SwarmFinFuture.Prefix (N := N) (m := m) r,
        (∑' pq : (k : ℕ) × (Fin k → JumpVec N),
          ENNReal.ofReal (RecKernel.hitW p pq.2
            (v ⟨r, Finset.mem_Iic.2 le_rfl⟩).2) *
            (if prefixNext p hm v pq ∈ SwarmFinFuture.prefixWindow K (r + 1) C then 1 else 0))
        ∂((SwarmInfSeg.infLaw (N := N) (m := m) p hm hp hp1 π).map
          (Preorder.frestrictLe (π := fun _ => SwarmInfSeg.Pair N m) r)) := by
  rw [SwarmFinFuture.chainLaw_window_eq_prefix p hm hp hp1 π hK hC]
  exact infLaw_prefix_succ_apply_hitW p hm hp hp1 π
    (SwarmFinFuture.measurableSet_prefixWindow hC)

end SwarmGeneralFuture


