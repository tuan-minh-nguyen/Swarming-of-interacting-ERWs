/-The public conditional-Borel–Cantelli engine `WCJF.RegenBC.ae_frequently_mem_of_kernel_force_of_tight`
(`Swarm/CondBC.lean`) is stated for an abstract filtration, an abstract kernel and an abstract
exhaustion.  This file instantiates it, without abstraction, at the repository's actual objects:

* path space `ℕ → RecState N m` with its **natural record filtration** `recordFilt N m`
  (`⨆_{k ≤ n} σ(ω ↦ ω k)`), see `pathEvalMeas` / `recordMeas` / `recordFilt`;
* path law `SimJump.RecKernel.recordTraj p hp hp1 hm μ₀` (the Ionescu–Tulcea law of the stopped
  record chain `hitKKernel`);
* kernel `SimJump.RecKernel.hitKKernel p hm`, which is definitionally `hitKInf p hm`
  (`hitKKernel_apply`), so the paper's force estimate `hitKInf_srSet_ge` applies verbatim;
* target set `F = srSet N m` (all walkers at distance `0` below the record, i.e. a simultaneous
  record), exhaustion `Kset K = exh N m K = {dmax ≤ K}`;
* force constant `c K = ofReal ((1-p)^(N(2K+1))) > 0` for `p < 1`.

Conclusions proved here (no new probabilistic input beyond those listed per theorem):

* `isProbabilityMeasure_recordTraj` — the record path law is a probability measure (from the
  `r = 0` marginal identity `recordTraj_eval`);
* `ae_frequently_dmax_le_of_tight` — **bounded-defect recurrence**: from the literal record
  tightness (uniform tail bounds on `exh N m K`) the record defect `dmax (ω r)` is almost surely
  infinitely often bounded; equivalently `dmax (ω r)` does not tend to infinity a.s.;
* `RecordStepIdentity` — the *single* residual probabilistic input, the one-step Markov identity
  `(recmark)` of the actual record path law, stated for `recordTraj`, `recordFilt`, `hitKKernel`,
  `srSet`.  It is a hypothesis, not proved here (it is direction m2 of this swarm);
* `ae_frequently_srSet_of_tight_of_step` — **capstone**: record tightness + that identity give,
  almost surely, infinitely many record levels whose record state is a simultaneous record
  `ω n ∈ srSet N m`;
* `ae_frequently_srSet_of_iterate_tight_of_step` — same from the iterate form of tightness
  (`(step hitKKernel)^[r] μ₀ (exh N m K)ᶜ ≤ ε`), via `htight_iff_pathlaw`;
* `recordTraj_tight_of_recordTrajT_tight` — exact transfer of the *paper's own* tightness output
  `∀ u, recordTrajT … {K < dT ω u} ≤ ε` (the shape proved from the two block clauses by
  `HdefDefect.record_tightness_of_two_actual_hdef_free`) into the `recordTraj` shape consumed above;
* `ae_frequently_srSet_of_dT_tight_of_step` — capstone in terms of that literal `dT` tightness.

Nothing here claims: the one-step identity, the two block clauses, the invariant law, regeneration,
`D = ⊤` nullity, or the common speed.  No `sorry`, no custom axiom, no `native_decide`.
-/
import Swarm.CondBC
import Swarm.ProbCtxRecord

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option warn.classDefReducibility false
set_option maxHeartbeats 1000000

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal BigOperators

namespace WCJF.RecFreq

open SwarmRec SimJump.RecKernel

variable {N m : ℕ}

/-! ### 1. The natural filtration of the record path space -/

/-- **The natural filtration of the record path space**: Mathlib's product filtration
`ProbabilityTheory.Filtration.piLE`, i.e. the σ-algebra of the record coordinates up to `n`.

This is deliberately *Mathlib's* filtration and not a bespoke one: `piLE n` is literally
`pi.comap (frestrictLe n)` (`ProbabilityTheory.Filtration.piLE_eq_comap_frestrictLe`), which is the
σ-algebra that `ProbabilityTheory.Kernel.condDistrib_trajMeasure` conditions on.  Hence the residual
one-step identity `RecordStepIdentity` below is stated on exactly the σ-algebra for which the
Ionescu–Tulcea Markov property is available. -/
noncomputable def recordFilt (N m : ℕ) :
    Filtration ℕ (inferInstance : MeasurableSpace (ℕ → RecState N m)) :=
  MeasureTheory.Filtration.piLE (X := fun _ => RecState N m)

/-- The natural record filtration *is* the σ-algebra generated by the trajectory up to `n`
(`frestrictLe n`), the one used by Mathlib's `condDistrib_trajMeasure`. -/
theorem recordFilt_eq_comap_frestrictLe (N m n : ℕ) :
    (recordFilt N m : ℕ → MeasurableSpace (ℕ → RecState N m)) n
      = MeasurableSpace.comap (Preorder.frestrictLe (π := fun _ => RecState N m) n)
          (inferInstance : MeasurableSpace ((i : ↥(Finset.Iic n)) → RecState N m)) :=
  MeasureTheory.Filtration.piLE_eq_comap_frestrictLe n

/-- The `n`-th record coordinate is measurable at time `n`. -/
theorem measurable_recordFilt (N m n : ℕ) :
    Measurable[recordFilt N m n] (fun ω : ℕ → RecState N m => ω n) := by
  rw [recordFilt_eq_comap_frestrictLe, measurable_iff_comap_le]
  have hfun : (fun ω : ℕ → RecState N m => ω n)
      = (fun f : (i : ↥(Finset.Iic n)) → RecState N m => f ⟨n, Finset.mem_Iic.mpr le_rfl⟩)
        ∘ Preorder.frestrictLe (π := fun _ => RecState N m) n := by
    funext ω
    rw [Function.comp_apply, Preorder.frestrictLe_apply]
  rw [hfun, ← MeasurableSpace.comap_comp]
  refine MeasurableSpace.comap_mono ?_
  exact measurable_iff_comap_le.mp (measurable_pi_apply _)

/-! ### 2. The record path law is a probability measure -/

/-- `recordTraj` is a probability measure whenever its initial record law is.  This is read off the
`r = 0` marginal identity `recordTraj_eval` and does not require the Ionescu–Tulcea instance. -/
theorem isProbabilityMeasure_recordTraj (p : ℝ) (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1) (hm : 1 ≤ m)
    (μ₀ : Measure (RecState N m)) [IsProbabilityMeasure μ₀] :
    IsProbabilityMeasure (recordTraj p hp hp1 hm μ₀) := by
  have h0 : (recordTraj p hp hp1 hm μ₀).map (fun ω : ℕ → RecState N m => ω 0) = μ₀ := by
    simpa using recordTraj_eval p hp hp1 hm μ₀ (0 : ℕ)
  constructor
  have hmap : ((recordTraj p hp hp1 hm μ₀).map (fun ω : ℕ → RecState N m => ω 0)) Set.univ
      = (recordTraj p hp hp1 hm μ₀) Set.univ := by
    rw [Measure.map_apply (measurable_pi_apply (0 : ℕ)) MeasurableSet.univ, Set.preimage_univ]
  rw [← hmap, h0]
  exact measure_univ

/-! ### 3. Bounded-defect recurrence from literal record tightness -/

/-- **Bounded-defect recurrence.**  From the uniform tail bounds on the exhaustion `exh N m K`
(i.e. `P(d_r > K) ≤ ε` uniformly in the record level `r`) the record defect `dmax (ω r)` is
almost surely infinitely often bounded: there is a level `K` with `dmax (ω r) ≤ K` for infinitely
many record levels.  No one-step identity and no invariant law is used. -/
theorem ae_frequently_dmax_le_of_tight (p : ℝ) (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1) (hm : 1 ≤ m)
    (μ₀ : Measure (RecState N m)) [IsProbabilityMeasure μ₀]
    (htight : ∀ (ε : ℝ≥0∞), 0 < ε → ∃ K : ℕ, ∀ r : ℕ,
      (recordTraj p hp hp1 hm μ₀) {ω : ℕ → RecState N m | ω r ∉ exh N m K} ≤ ε) :
    ∀ᵐ ω ∂(recordTraj p hp hp1 hm μ₀),
      ∃ K : ℕ, ∃ᶠ r in atTop, dmax (ω r) ≤ K := by
  haveI := isProbabilityMeasure_recordTraj (N := N) (m := m) p hp hp1 hm μ₀
  have htail : ∀ (ε : ℝ≥0∞), 0 < ε → ∃ K : ℕ, ∀ r : ℕ,
      (recordTraj p hp hp1 hm μ₀) {ω : ℕ → RecState N m | K ≤ dmax (ω r)} ≤ ε := by
    intro ε hε
    obtain ⟨K, hK⟩ := htight ε hε
    refine ⟨K + 1, fun r => ?_⟩
    have hset : {ω : ℕ → RecState N m | K + 1 ≤ dmax (ω r)} = {ω | ω r ∉ exh N m K} := by
      ext ω
      simp only [Set.mem_ofPred_eq]
      rw [Nat.succ_le_iff, dmax_lt_iff_not_mem_exh]
    rw [hset]
    exact hK r
  have hT := WCJF.RegenBC.ae_not_tendsto_atTop_of_uniform_tail
    (μ := recordTraj p hp hp1 hm μ₀) (d := fun r ω => dmax (ω r)) htail
  filter_upwards [hT] with ω hω
  exact WCJF.RegenBC.exists_frequently_le_of_not_tendsto hω

/-- The target set `srSet N m` is the zero-defect set: a record state is a simultaneous record iff
its record defect `dmax` vanishes (equivalently `dT = 2 * dmax = 0` on the extended chain). -/
theorem dmax_eq_zero_iff_mem_srSet (y : RecState N m) : dmax y = 0 ↔ y ∈ srSet N m := by
  rw [srSet, mem_exh_iff_dmax_le]
  omega

/-! ### 4. The one-step Markov identity, as one named residual -/

/-- **The one-step Markov identity `(recmark)` of the actual record path law**: the conditional
probability that the next record state lies in the simultaneous-record set `srSet N m` is the
kernel mass `hitKKernel p hm (·) (srSet N m)` evaluated at the current record state.

This is the single probabilistic input that is *not* proved here (direction m2 of the swarm); it is
the path-law form of the Markov property of `recordTraj`, whose kernel is `hitKKernel`. -/
def RecordStepIdentity (p : ℝ) (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1) (hm : 1 ≤ m)
    (μ₀ : Measure (RecState N m)) : Prop :=
  ∀ n : ℕ,
    (recordTraj p hp hp1 hm μ₀)[Set.indicator
        {ω : ℕ → RecState N m | ω (n + 1) ∈ srSet N m} (fun _ => (1 : ℝ)) |
        recordFilt N m n]
      =ᵐ[recordTraj p hp hp1 hm μ₀]
        (fun ω => ((hitKKernel p hm) (ω n) (srSet N m)).toReal)

/-! ### 5. Capstone: infinitely many simultaneous records a.s. -/

/-- **The frequency step of the initial regeneration for the literal record chain.**

Premises, exactly:

* `hp, hp1, hm, hN` — the model regime (`1/2 ≤ p ≤ 1`, `1 ≤ m`, `N > 0`);
* `hp_lt : p < 1` — strict positivity of the force constant `(1-p)^(N(2K+1))`;
* `μ₀` — the initial record law (a probability measure);
* `hstep` — the one-step Markov identity `RecordStepIdentity` of the actual path law;
* `htight` — the literal record tightness, in path-law uniform-tail form.

Conclusion: almost surely infinitely many record levels `n` have `ω n ∈ srSet N m`, i.e. infinitely
many record times at which **all** walkers are at the record position (a simultaneous record).

The engine is `WCJF.RegenBC.ae_frequently_mem_of_kernel_force_of_tight`; the force estimate is
`hitKInf_srSet_ge` transported along `hitKKernel_apply`; the exhaustion identity
`exh N m K = {dmax ≤ K}` is `mem_exh_iff_dmax_le`. -/
theorem ae_frequently_srSet_of_tight_of_step (p : ℝ) (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1)
    (hp_lt : p < 1) (hm : 1 ≤ m) (hN : 0 < N)
    (μ₀ : Measure (RecState N m)) [IsProbabilityMeasure μ₀]
    (hstep : RecordStepIdentity (N := N) (m := m) p hp hp1 hm μ₀)
    (htight : ∀ (ε : ℝ≥0∞), 0 < ε → ∃ K : ℕ, ∀ r : ℕ,
      (recordTraj p hp hp1 hm μ₀) {ω : ℕ → RecState N m | ω r ∉ exh N m K} ≤ ε) :
    ∀ᵐ ω ∂(recordTraj p hp hp1 hm μ₀),
      ∃ᶠ n in atTop, ω n ∈ srSet N m := by
  haveI hMK : IsMarkovKernel (hitKKernel (N := N) (m := m) p hm) :=
    isMarkovKernel_hitKKernel p hp hp1 hm
  haveI := isProbabilityMeasure_recordTraj (N := N) (m := m) p hp hp1 hm μ₀
  refine WCJF.RegenBC.ae_frequently_mem_of_kernel_force_of_tight
    (μ := recordTraj p hp hp1 hm μ₀) (ℱ := recordFilt N m)
    (Y := fun n (ω : ℕ → RecState N m) => ω n) (F := srSet N m)
    (κ := hitKKernel (N := N) (m := m) p hm) (Kset := fun K => exh N m K)
    (c := fun K => ENNReal.ofReal ((1 - p) ^ (N * (2 * K + 1))))
    (dep := dmax)
    (fun n => measurable_recordFilt N m n) (measurableSet_srSet N m) ?_ hstep ?_ ?_ htight
  · intro K y hy
    rw [hitKKernel_apply]
    exact hitKInf_srSet_ge p hp hp1 hm hN K y hy
  · intro K
    exact WCJF.RegenBC.paper_constant_pos hp_lt N K
  · intro K
    ext y
    exact mem_exh_iff_dmax_le y K

/-- The same capstone from the **iterate form** of record tightness,
`(step hitKKernel)^[r] μ₀ (exh N m K)ᶜ ≤ ε`, which is the shape of the repository's `htight`
input (`Swarm/InfKernel.lean`), via `htight_iff_pathlaw`. -/
theorem ae_frequently_srSet_of_iterate_tight_of_step (p : ℝ) (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1)
    (hp_lt : p < 1) (hm : 1 ≤ m) (hN : 0 < N)
    (μ₀ : Measure (RecState N m)) [IsProbabilityMeasure μ₀]
    (hstep : RecordStepIdentity (N := N) (m := m) p hp hp1 hm μ₀)
    (htight : ∀ (ε : ℝ≥0∞), 0 < ε → ∃ K : ℕ, ∀ r : ℕ,
      ((SwarmKB.step (hitKKernel (N := N) (m := m) p hm))^[r] μ₀) (exh N m K)ᶜ ≤ ε) :
    ∀ᵐ ω ∂(recordTraj p hp hp1 hm μ₀),
      ∃ᶠ n in atTop, ω n ∈ srSet N m :=
  ae_frequently_srSet_of_tight_of_step (N := N) (m := m) p hp hp1 hp_lt hm hN μ₀ hstep
    ((htight_iff_pathlaw (N := N) (m := m) p hp hp1 hm μ₀).mp htight)

/-! ### 6. Transfer of the paper's own tightness output (`dT` on the extended chain) -/

/-- The first-coordinate marginal of a probability measure on `RecState × ℕ` is a probability
measure (used to feed the extended-chain tightness into the record-chain shape). -/
theorem isProbabilityMeasure_map_fst (ν : Measure (RecState N m × ℕ)) [IsProbabilityMeasure ν] :
    IsProbabilityMeasure (ν.map Prod.fst) :=
  Measure.isProbabilityMeasure_map measurable_fst.aemeasurable

/-- **Exact transfer of the `dT` tightness into the `recordTraj` shape.**

`HdefDefect.record_tightness_of_two_actual_hdef_free` (and its ancestors) produce tightness of the
*time-extended* canonical record path law in the literal paper variable

  `dT ω u = 2 * dmax ((ω u).1)`,

namely `∀ u, recordTrajT … {ω | K < dT ω u} ≤ ε`.  Since the extended chain's first coordinate is the
record chain (`recordTrajT_tail`) and `¬ (dmax ≤ K/2) ↔ K < 2 * dmax`, this is the same tail with
level `K / 2` for `recordTraj` started from `ν.map Prod.fst`. -/
theorem recordTraj_tight_of_recordTrajT_tight (p : ℝ) (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1)
    (hm : 1 ≤ m) (ν : Measure (RecState N m × ℕ)) [IsProbabilityMeasure ν]
    (h : ∀ (ε : ℝ≥0∞), 0 < ε → ∃ K : ℕ, ∀ u : ℕ,
      (recordTrajT p hp hp1 hm ν) {ω : ℕ → RecState N m × ℕ | K < dT ω u} ≤ ε) :
    ∀ (ε : ℝ≥0∞), 0 < ε → ∃ K : ℕ, ∀ r : ℕ,
      (recordTraj p hp hp1 hm (ν.map Prod.fst))
        {ω : ℕ → RecState N m | ω r ∉ exh N m K} ≤ ε := by
  intro ε hε
  haveI := isProbabilityMeasure_map_fst (N := N) (m := m) ν
  obtain ⟨K, hK⟩ := h ε hε
  refine ⟨K / 2, fun r => ?_⟩
  have hset : {ω : ℕ → RecState N m × ℕ | (ω r).1 ∈ exh N m (K / 2)}ᶜ
      = {ω : ℕ → RecState N m × ℕ | K < dT ω r} := by
    ext ω
    simp only [Set.mem_compl_iff, Set.mem_ofPred_eq, dT]
    rw [← dmax_lt_iff_not_mem_exh, Nat.div_lt_iff_lt_mul (by norm_num : 0 < 2)]
    omega
  have h1 : (recordTraj p hp hp1 hm (ν.map Prod.fst))
        {ω : ℕ → RecState N m | ω r ∉ exh N m (K / 2)}
      = (recordTrajT p hp hp1 hm ν)
          {ω : ℕ → RecState N m × ℕ | (ω r).1 ∈ exh N m (K / 2)}ᶜ := by
    rw [← recordTraj_tail p hp hp1 hm (ν.map Prod.fst) r (K / 2),
      recordTrajT_tail p hp hp1 hm ν r (K / 2)]
  rw [h1, hset]
  exact hK r

/-- **Capstone in the literal `dT` coordinates**: tightness of the time-extended record chain in
the paper's defect `dT`, plus the one-step Markov identity, give almost surely infinitely many
simultaneous records for the record chain started from `ν.map Prod.fst`. -/
theorem ae_frequently_srSet_of_dT_tight_of_step (p : ℝ) (hp : 1 / 2 ≤ p) (hp1 : p ≤ 1)
    (hp_lt : p < 1) (hm : 1 ≤ m) (hN : 0 < N)
    (ν : Measure (RecState N m × ℕ)) [IsProbabilityMeasure ν]
    (hstep : RecordStepIdentity (N := N) (m := m) p hp hp1 hm (ν.map Prod.fst))
    (htight : ∀ (ε : ℝ≥0∞), 0 < ε → ∃ K : ℕ, ∀ u : ℕ,
      (recordTrajT p hp hp1 hm ν) {ω : ℕ → RecState N m × ℕ | K < dT ω u} ≤ ε) :
    ∀ᵐ ω ∂(recordTraj p hp hp1 hm (ν.map Prod.fst)),
      ∃ᶠ n in atTop, ω n ∈ srSet N m := by
  haveI := isProbabilityMeasure_map_fst (N := N) (m := m) ν
  exact ae_frequently_srSet_of_tight_of_step (N := N) (m := m) p hp hp1 hp_lt hm hN _
    hstep (recordTraj_tight_of_recordTrajT_tight p hp hp1 hm ν htight)

end WCJF.RecFreq
