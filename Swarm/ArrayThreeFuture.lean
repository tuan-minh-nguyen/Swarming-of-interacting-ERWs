/-
# Actual array continuation: strict positivity through 3, arbitrary raw future

This module keeps the strict-positivity horizon and the pattern horizon separate.  The event is
`finStrict k1 ∩ pathPat (k1+k2) ⁻¹' C`, not `finStrict (k1+k2)`: suffix jumps are constrained by
`C`, but need not remain positive.  The proof uses the actual array jump boxes and their exact
successor-state weights.  It does not project `C` to a prefix and assumes no independence.

The second part specializes `k1 = 3`, where the first two jumps are all-right and the third is
free.  No chain-side equality, stationarity, regeneration, `hstruct`, or invariant law is claimed.
-/
import Swarm.WordSplitSum

open MeasureTheory Set
open scoped ENNReal BigOperators
open Classical

attribute [local instance] Classical.propDecidable

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

namespace SwarmArrayFuture

open Swarming Swarming.Uniform Swarming.Trajectory Swarming.Transition Swarming.CurrentState
open SimJump SimJump.Record
open SwarmRec SwarmFreshPos SwarmFreshCyl SwarmFreshArray SwarmFinHorizon SwarmRestart
  SwarmFresh SwarmArrayWords

variable {N : ℕ}

/-- On a box of length `k1+k2`, strict positivity through `k1` is precisely positivity of the
prefix word.  No condition is imposed on the suffix. -/
theorem posPath_mem_finStrict_pref_iff (p : ℝ) (m k1 k2 : ℕ)
    (w : Fin (k1 + k2) → JumpVec N) {U : Array N}
    (hbox : U ∈ jbox p m (k1 + k2) w) :
    posPath p m U ∈ finStrict (N := N) k1 ↔ PosSeqFin (N := N) (prefWord w) := by
  rw [mem_finStrict, posWord_iff]
  constructor
  · rintro ⟨-, h⟩ n hn1 hnk i
    have hle : n ≤ k1 + k2 := by omega
    have h' := h n hn1 hnk i
    rw [posPath_apply, array_trajectory_pos_eq_wordCyl p m w hbox hle i] at h'
    rwa [← posAt_prefWord_eq w hnk i]
  · intro h
    refine ⟨fun i => posPath_zero p m U i, fun n hn1 hnk i => ?_⟩
    have hle : n ≤ k1 + k2 := by omega
    rw [posPath_apply, array_trajectory_pos_eq_wordCyl p m w hbox hle i,
      posAt_prefWord_eq w hnk i]
    exact h n hn1 hnk i

/-- The mixed-horizon cylinder is a word predicate of the first `k1+k2` jumps.  In particular,
`C` may inspect every raw position through `k1+k2`. -/
theorem finStrict_prefix_future_eq_wordSet (p : ℝ) (m k1 k2 : ℕ)
    (C : Set (Fin (k1 + k2 + 1) → Fin N → ℤ)) :
    {U : Array N | posPath p m U ∈
        finStrict (N := N) k1 ∩ pathPat (N := N) (k1 + k2) ⁻¹' C}
      = {U : Array N | PosSeqFin (N := N) (prefWord (jumpWord p m (k1 + k2) U))
          ∧ patOf (N := N) (jumpWord p m (k1 + k2) U) ∈ C} := by
  ext U
  have hbox := mem_jbox_jumpWord p m (k1 + k2) U
  have hpat := pathPat_posPath_eq_patOf p m (k1 + k2) (jumpWord p m (k1 + k2) U) hbox
  have hpos := posPath_mem_finStrict_pref_iff p m k1 k2 (jumpWord p m (k1 + k2) U) hbox
  simp only [mem_ofPred_eq, mem_inter_iff, mem_preimage]
  rw [hpat, hpos]

/-- **Mixed-horizon two-block array decomposition.**  The first word controls strict positivity;
the whole concatenated word controls the arbitrary pattern.  The second weight starts at the
state generated by the first word, so this is an exact conditional-weight decomposition and not
an independent stationary sum. -/
theorem arrayMeasure_finStrict_prefix_future_twoBlock
    (p : ℝ) (hp0 : (1 : ℝ) / 2 < p) (hp1 : p < 1) (m k1 k2 : ℕ)
    (C : Set (Fin (k1 + k2 + 1) → Fin N → ℤ)) :
    (arrayMeasure N) {U : Array N | posPath p m U ∈
        finStrict (N := N) k1 ∩ pathPat (N := N) (k1 + k2) ⁻¹' C}
      = ∑ q1 : Fin k1 → JumpVec N, ∑ q2 : Fin k2 → JumpVec N,
          if PosSeqFin (N := N) q1 ∧ patOf (N := N) (catWord q1 q2) ∈ C then
            ENNReal.ofReal
              (pathW p k1 q1 (SwarmFreshArray.startState (N := N) m)
                * pathW p k2 q2
                    (capState m (runJ m (extendPath q1) k1)))
          else 0 := by
  rw [finStrict_prefix_future_eq_wordSet,
    mass_wordSet p hp0 hp1 m (k1 + k2)
      (fun w => PosSeqFin (N := N) (prefWord w) ∧ patOf (N := N) w ∈ C)]
  have hstep :
      (∑ w : Fin (k1 + k2) → JumpVec N,
        if PosSeqFin (N := N) (prefWord w) ∧ patOf (N := N) w ∈ C then
          ENNReal.ofReal (pathW p (k1 + k2) w (SwarmFreshArray.startState (N := N) m))
        else 0)
      = ∑ w : Fin (k1 + k2) → JumpVec N,
        if PosSeqFin (N := N) (prefWord w)
            ∧ patOf (N := N) (catWord (prefWord w) (suffWord w)) ∈ C then
          ENNReal.ofReal
            (pathW p k1 (prefWord w) (SwarmFreshArray.startState (N := N) m)
              * pathW p k2 (suffWord w)
                  (capState m (runJ m (extendPath (prefWord w)) k1)))
        else 0 := by
    refine Finset.sum_congr rfl fun w _ => ?_
    rw [pathW_split, catWord_pref_suff]
  rw [hstep]
  exact sum_split_words (N := N) (fun q1 q2 =>
    if PosSeqFin (N := N) q1 ∧ patOf (N := N) (catWord q1 q2) ∈ C then
      ENNReal.ofReal
        (pathW p k1 q1 (SwarmFreshArray.startState (N := N) m)
          * pathW p k2 q2 (capState m (runJ m (extendPath q1) k1)))
    else 0)

/-- Consequently every such mixed-horizon event is measurable, even if `C` itself is arbitrary.
This is a by-product of the finite box partition, not an assumption on `C`. -/
theorem measurableSet_finStrict_prefix_future (p : ℝ) (m k1 k2 : ℕ)
    (C : Set (Fin (k1 + k2 + 1) → Fin N → ℤ)) :
    MeasurableSet {U : Array N | posPath p m U ∈
      finStrict (N := N) k1 ∩ pathPat (N := N) (k1 + k2) ⁻¹' C} := by
  rw [finStrict_prefix_future_eq_wordSet]
  exact measurableSet_wordSet p m (k1 + k2)
    (fun w => PosSeqFin (N := N) (prefWord w) ∧ patOf (N := N) w ∈ C)

/-! ## The free third letter and all later letters -/

/-- Local names for the all-right vector and the word `(R,R,v)`.  They are kept local to this
module so the proof needs only the already compiled word-split interface. -/
def allRight (N : ℕ) : JumpVec N := fun _ => true

def qRav (N : ℕ) (v : JumpVec N) : Fin 3 → JumpVec N :=
  fun k => if (k : ℕ) < 2 then allRight N else v

theorem qRav_zero (N : ℕ) (v : JumpVec N) : qRav N v ⟨0, by omega⟩ = allRight N := by
  simp [qRav]

theorem qRav_one (N : ℕ) (v : JumpVec N) : qRav N v ⟨1, by omega⟩ = allRight N := by
  simp [qRav]

theorem qRav_two (N : ℕ) (v : JumpVec N) : qRav N v ⟨2, by omega⟩ = v := by
  simp [qRav]

theorem posAt_seqOf_one {k : ℕ} (q : Fin k → JumpVec N) (hk : 0 < k) (i : Fin N) :
    posAt (seqOf q) 1 i = if q ⟨0, hk⟩ i = true then (1 : ℤ) else -1 := by
  rw [posAt, Finset.sum_range_one]
  simp [seqOf, hk]

theorem posAt_seqOf_two {k : ℕ} (q : Fin k → JumpVec N) (hk : 2 ≤ k) (i : Fin N) :
    posAt (seqOf q) 2 i
      = (if q ⟨0, by omega⟩ i = true then (1 : ℤ) else -1)
        + (if q ⟨1, by omega⟩ i = true then (1 : ℤ) else -1) := by
  rw [posAt, Finset.sum_range_succ, Finset.sum_range_one]
  simp [seqOf, show (0 : ℕ) < k by omega, show (1 : ℕ) < k by omega]

theorem posAt_seqOf_three {k : ℕ} (q : Fin k → JumpVec N) (hk : 3 ≤ k) (i : Fin N) :
    posAt (seqOf q) 3 i
      = ((if q ⟨0, by omega⟩ i = true then (1 : ℤ) else -1)
          + (if q ⟨1, by omega⟩ i = true then (1 : ℤ) else -1))
        + (if q ⟨2, by omega⟩ i = true then (1 : ℤ) else -1) := by
  rw [show (3 : ℕ) = 2 + 1 from rfl, posAt_succ, posAt_seqOf_two q (by omega) i,
    seqOf_val q ⟨2, by omega⟩]

/-- Every word `(R,R,v)` is positive through time 3; the third letter is unrestricted. -/
theorem posSeqFin_qRav (v : JumpVec N) : PosSeqFin (N := N) (qRav N v) := by
  intro n hn i
  fin_cases n
  · simp at hn
  · rw [posAt_seqOf_one (qRav N v) (by omega) i]
    simp only [qRav_zero, allRight, if_true]
    norm_num
  · rw [posAt_seqOf_two (qRav N v) (by omega) i]
    simp only [qRav_zero, qRav_one, allRight, if_true]
    norm_num
  · rw [posAt_seqOf_three (qRav N v) (by omega) i]
    simp only [qRav_zero, qRav_one, allRight, if_true]
    split_ifs <;> norm_num

/-- Positivity through time 3 forces exactly the first two letters, not the third. -/
theorem eq_qRav_of_posSeqFin {q : Fin 3 → JumpVec N} (h : PosSeqFin (N := N) q) :
    q = qRav N (q ⟨2, by omega⟩) := by
  have h0 : ∀ i, q ⟨0, by omega⟩ i = true := by
    intro i
    have h1 := h ⟨1, by omega⟩ (by simp) i
    rw [posAt_seqOf_one q (by omega) i] at h1
    revert h1
    cases hq : q ⟨0, by omega⟩ i <;> simp
  have h1 : ∀ i, q ⟨1, by omega⟩ i = true := by
    intro i
    have h2 := h ⟨2, by omega⟩ (by simp) i
    rw [posAt_seqOf_two q (by omega) i, h0 i] at h2
    revert h2
    cases hq : q ⟨1, by omega⟩ i <;> simp
  funext k i
  fin_cases k
  · rw [qRav_zero]; exact h0 i
  · rw [qRav_one]; exact h1 i
  · rw [qRav_two]

/-- Reindex a sum supported on positive three-letter words by the free third letter. -/
theorem sum_posSeqFin_three {M : Type*} [AddCommMonoid M]
    (F : (Fin 3 → JumpVec N) → M) :
    (∑ q : Fin 3 → JumpVec N, if PosSeqFin (N := N) q then F q else 0)
      = ∑ v : JumpVec N, F (qRav N v) := by
  rw [← Finset.sum_filter]
  refine Finset.sum_bij (fun q _ => q ⟨2, by omega⟩) ?_ ?_ ?_ ?_
  · intro q hq
    exact Finset.mem_univ _
  · intro q hq q' hq' hqq'
    have hp := (Finset.mem_filter.mp hq).2
    have hp' := (Finset.mem_filter.mp hq').2
    calc
      q = qRav N (q ⟨2, by omega⟩) := eq_qRav_of_posSeqFin hp
      _ = qRav N (q' ⟨2, by omega⟩) := congrArg (qRav N) hqq'
      _ = q' := (eq_qRav_of_posSeqFin hp').symm
  · intro v hv
    refine ⟨qRav N v, ?_, ?_⟩
    · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, posSeqFin_qRav v⟩
    · exact qRav_two N v
  · intro q hq
    have hp := (Finset.mem_filter.mp hq).2
    exact congrArg F (eq_qRav_of_posSeqFin hp)

/-- **Fixed `K=3`, arbitrary raw horizon `n=3+r`.**  The sum ranges over the free third letter
`v` and *every* length-`r` suffix word.  `C` reads the entire raw path through time `3+r`, while
only the first three positions are constrained by `finStrict 3`.  The suffix weight is evaluated
at the actual state after `(R,R,v)`, including all capped local times. -/
theorem arrayMeasure_finStrict_three_future
    (p : ℝ) (hp0 : (1 : ℝ) / 2 < p) (hp1 : p < 1) (m r : ℕ)
    (C : Set (Fin (3 + r + 1) → Fin N → ℤ)) :
    (arrayMeasure N) {U : Array N | posPath p m U ∈
        finStrict (N := N) 3 ∩ pathPat (N := N) (3 + r) ⁻¹' C}
      = ∑ v : JumpVec N, ∑ q2 : Fin r → JumpVec N,
          if patOf (N := N) (catWord (qRav N v) q2) ∈ C then
            ENNReal.ofReal
              (pathW p 3 (qRav N v) (SwarmFreshArray.startState (N := N) m)
                * pathW p r q2 (capState m (runJ m (extendPath (qRav N v)) 3)))
          else 0 := by
  rw [arrayMeasure_finStrict_prefix_future_twoBlock p hp0 hp1 m 3 r C]
  have hsplit :
      (∑ q1 : Fin 3 → JumpVec N, ∑ q2 : Fin r → JumpVec N,
        if PosSeqFin (N := N) q1 ∧ patOf (N := N) (catWord q1 q2) ∈ C then
          ENNReal.ofReal
            (pathW p 3 q1 (SwarmFreshArray.startState (N := N) m)
              * pathW p r q2 (capState m (runJ m (extendPath q1) 3)))
        else 0)
      = ∑ q1 : Fin 3 → JumpVec N,
          if PosSeqFin (N := N) q1 then
            ∑ q2 : Fin r → JumpVec N,
              if patOf (N := N) (catWord q1 q2) ∈ C then
                ENNReal.ofReal
                  (pathW p 3 q1 (SwarmFreshArray.startState (N := N) m)
                    * pathW p r q2 (capState m (runJ m (extendPath q1) 3)))
              else 0
          else 0 := by
    refine Finset.sum_congr rfl fun q1 _ => ?_
    by_cases hq : PosSeqFin (N := N) q1
    · rw [if_pos hq]
      refine Finset.sum_congr rfl fun q2 _ => ?_
      by_cases hC : patOf (N := N) (catWord q1 q2) ∈ C
      · rw [if_pos (And.intro hq hC), if_pos hC]
      · rw [if_neg (fun h => hC h.2), if_neg hC]
    · rw [if_neg hq]
      apply Finset.sum_eq_zero
      intro q2 hq2
      exact if_neg (fun h => hq h.1)
  rw [hsplit]
  exact sum_posSeqFin_three (N := N) (fun q1 =>
    ∑ q2 : Fin r → JumpVec N,
      if patOf (N := N) (catWord q1 q2) ∈ C then
        ENNReal.ofReal
          (pathW p 3 q1 (SwarmFreshArray.startState (N := N) m)
            * pathW p r q2 (capState m (runJ m (extendPath q1) 3)))
      else 0)

/-- The same decomposition with the first-three weight read at any actual simultaneous-record
state.  Only the positive prefix is transferred to `ofRecState y`; the suffix stays at its
array-generated successor state. -/
theorem arrayMeasure_finStrict_three_future_ofRecState
    (p : ℝ) (hp0 : (1 : ℝ) / 2 < p) (hp1 : p < 1) {m : ℕ} (hm : 1 ≤ m)
    {y : RecState N m} (hy : y ∈ srSet N m) (r : ℕ)
    (C : Set (Fin (3 + r + 1) → Fin N → ℤ)) :
    (arrayMeasure N) {U : Array N | posPath p m U ∈
        finStrict (N := N) 3 ∩ pathPat (N := N) (3 + r) ⁻¹' C}
      = ∑ v : JumpVec N, ∑ q2 : Fin r → JumpVec N,
          if patOf (N := N) (catWord (qRav N v) q2) ∈ C then
            ENNReal.ofReal
              (pathW p 3 (qRav N v) (Record.ofRecState y)
                * pathW p r q2 (capState m (runJ m (extendPath (qRav N v)) 3)))
          else 0 := by
  rw [arrayMeasure_finStrict_three_future p hp0 hp1 m r C]
  refine Finset.sum_congr rfl fun v _ => Finset.sum_congr rfl fun q2 _ => ?_
  rw [pathW_startState_eq hm hy (qRav N v) (posSeqFin_qRav v)]

/-- A finite word has positive weight from every capped state, not only from the canonical start.
This is the lower bound needed for residual suffix weights. -/
theorem pathW_pos_of_state {m : ℕ} (p : ℝ) (hp0 : (1 : ℝ) / 2 < p) (hp1 : p < 1)
    (r : ℕ) (q : Fin r → JumpVec N) (s : State N m) :
    0 < pathW p r q s := by
  have hge := pathWFun_ge p (extendPath q) (le_of_lt hp0) (le_of_lt hp1) r s
  rw [← pathW_eq_pathWFun_extendPath] at hge
  have hpos : (0 : ℝ) < (1 - p) ^ (N * r) := pow_pos (by linarith) _
  linarith

/-- Every specified full-pattern slice is non-vacuous, including slices of a pattern `C` that
reads raw positions after time 3.  There is no requirement that the third or any later jump be
all-right.  The selected `(v,q2)` summand is strictly positive; other summands only add mass. -/
theorem arrayMeasure_finStrict_three_future_pattern_singleton_pos
    (p : ℝ) (hp0 : (1 : ℝ) / 2 < p) (hp1 : p < 1) (m r : ℕ)
    (v : JumpVec N) (q2 : Fin r → JumpVec N) :
    0 < (arrayMeasure N) {U : Array N | posPath p m U ∈
      finStrict (N := N) 3 ∩ pathPat (N := N) (3 + r) ⁻¹'
        {patOf (N := N) (catWord (qRav N v) q2)}} := by
  rw [arrayMeasure_finStrict_three_future p hp0 hp1 m r]
  have hpre : 0 < pathW p 3 (qRav N v) (SwarmFreshArray.startState (N := N) m) :=
    SwarmArrayWords.pathW_pos hp0 hp1 m 3 _
  have hsuff : 0 < pathW p r q2 (capState m (runJ m (extendPath (qRav N v)) 3)) :=
    pathW_pos_of_state p hp0 hp1 r q2 _
  have hselected : 0 < ENNReal.ofReal
      (pathW p 3 (qRav N v) (SwarmFreshArray.startState (N := N) m)
        * pathW p r q2 (capState m (runJ m (extendPath (qRav N v)) 3))) :=
    ENNReal.ofReal_pos.mpr (mul_pos hpre hsuff)
  let F : JumpVec N → (Fin r → JumpVec N) → ℝ≥0∞ := fun v' q' =>
    @ite ℝ≥0∞
      (patOf (N := N) (catWord (qRav N v') q') ∈
        ({patOf (N := N) (catWord (qRav N v) q2)} :
          Set (Fin (3 + r + 1) → Fin N → ℤ)))
      (Classical.propDecidable _)
      (ENNReal.ofReal
        (pathW p 3 (qRav N v') (SwarmFreshArray.startState (N := N) m)
          * pathW p r q' (capState m (runJ m (extendPath (qRav N v')) 3))))
      0
  suffices h : 0 < ∑ v' : JumpVec N, ∑ q' : Fin r → JumpVec N, F v' q' by
    simpa only [F] using h
  have hFv : 0 < F v q2 := by
    dsimp [F]
    rw [if_pos (Set.mem_singleton_iff.mpr rfl)]
    exact hselected
  have hinner : 0 < ∑ q' : Fin r → JumpVec N, F v q' := by
    refine lt_of_lt_of_le hFv ?_
    exact Finset.single_le_sum (fun _ _ => bot_le) (Finset.mem_univ q2)
  refine lt_of_lt_of_le hinner ?_
  exact Finset.single_le_sum
    (fun w _ => show (0 : ℝ≥0∞) ≤ ∑ q' : Fin r → JumpVec N, F w q' from bot_le)
    (Finset.mem_univ v)

end SwarmArrayFuture


