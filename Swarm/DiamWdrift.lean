/-
  **`(diam)` input, part 3: the structural lemmas of Proposition `group`'s drift step.**

  The paper's proof of (Wdrift) takes the conditional mean of
  `W_{n+1}^{I,J} ≤ average_I H_n^{J^c}(X_{n+1}) - max_J H_n^{J^c}(X_{n+1})` (on (sep)) and
  needs two facts about the conditional expectation: it commutes with the finite average
  over `I`, and the conditional mean of a finite **maximum** is at least the maximum of the
  conditional means.  Neither is in the tree; both are proved here for the actual model and
  the paper's position filtration.  The separation event itself is shown to be adapted.

  All statements are about `arrayMeasure N` on the actual uniform array space and
  `posFilt N p m n`, the filtration generated by the walkers' positions.
-/
import Swarm.DiamDrift

set_option maxHeartbeats 2000000
set_option linter.unusedVariables false

open MeasureTheory ProbabilityTheory
open scoped ENNReal BigOperators

namespace SwarmM3

open Swarming Swarming.Uniform Swarming.Trajectory SepGroup.Model

variable {N : ℕ}

/-! ### The separation event is adapted -/

/-- (sep) at time `n`, unfolded: the running maximum is the maximum of finitely many
positions, so the condition `runMax + 2 ≤ X_n^i` is a finite conjunction of comparisons of
adapted positions. -/
theorem sep_iff_forall (p : ℝ) (m : ℕ) (U : Array N) (n : ℕ) (I J : Finset (Fin N)) :
    Sep p m U n I J ↔ (∀ i, 0 ≤ X p m U n i) ∧
      ∀ i ∈ I, ∀ j ∈ J, ∀ t ∈ Finset.range (n + 1), X p m U t j + 2 ≤ X p m U n i := by
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨h1, ?_⟩
    intro i hi j hj t ht
    have hmem : t ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp ht)
    have hle : X p m U t j ≤ Swarming.Trajectory.runMax p m U j n := by
      rw [Swarming.Trajectory.runMax]
      exact Finset.le_sup' (fun s => X p m U s j) (Finset.mem_range.mpr (Nat.lt_succ_of_le hmem))
    have h2' := h2 i hi j hj
    omega
  · rintro ⟨h1, h2⟩
    refine ⟨h1, fun i hi j hj => ?_⟩
    obtain ⟨t, ht, hte⟩ := Swarming.Trajectory.exists_eq_runMax p m U j n
    have hte' : X p m U t j = Swarming.Trajectory.runMax p m U j n := hte
    have h := h2 i hi j hj t (Finset.mem_range.mpr (Nat.lt_succ_of_le ht))
    rw [← hte']
    exact h

theorem measurableSet_Sep_posFilt (p : ℝ) (m : ℕ) (n : ℕ) (I J : Finset (Fin N)) :
    MeasurableSet[posFilt N p m n] {U : Array N | Sep p m U n I J} := by
  have heq : {U : Array N | Sep p m U n I J}
      = {U : Array N | ∀ i, 0 ≤ X p m U n i} ∩
        ⋂ i ∈ I, ⋂ j ∈ J, ⋂ t ∈ Finset.range (n + 1),
          {U : Array N | X p m U t j + 2 ≤ X p m U n i} := by
    ext U
    simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter, Set.mem_range]
    exact sep_iff_forall p m U n I J
  rw [heq]
  refine MeasurableSet.inter ?_ ?_
  · have hset : {U : Array N | ∀ i, 0 ≤ X p m U n i}
        = ⋂ i, {U : Array N | 0 ≤ X p m U n i} := by
      ext U; simp
    rw [hset]
    exact MeasurableSet.iInter fun i =>
      measurableSet_le (measurable_const_posFilt_int p m n 0) (measurable_pos_posFilt p m i le_rfl)
  · refine MeasurableSet.iInter fun i => MeasurableSet.iInter fun _ =>
      MeasurableSet.iInter fun j => MeasurableSet.iInter fun _ =>
      MeasurableSet.iInter fun t => MeasurableSet.iInter fun ht => ?_
    have ht' : t ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp ht)
    exact measurableSet_le ((measurable_pos_posFilt p m j ht').add
      (measurable_const_posFilt_int p m n 2)) (measurable_pos_posFilt p m i le_rfl)

/-- The separation event implies the nonnegativity of every walker's position. -/
theorem Sep_nonneg (p : ℝ) (m : ℕ) (U : Array N) (n : ℕ) (I J : Finset (Fin N))
    (h : Sep p m U n I J) (i : Fin N) : 0 ≤ X p m U n i := h.1 i

/-! ### The conditional mean of a finite maximum dominates the maximum of the means -/

theorem condExp_sup'_le (p : ℝ) (m : ℕ) (n : ℕ) {ι : Type*} (s : Finset ι) (hs : s.Nonempty)
    {f : ι → Array N → ℝ} (hint : ∀ i ∈ s, Integrable (f i) (arrayMeasure N))
    (hintsup : Integrable (fun U : Array N => s.sup' hs (fun i => f i U)) (arrayMeasure N)) :
    (fun U : Array N => s.sup' hs (fun i => condExp (posFilt N p m n) (arrayMeasure N) (f i) U))
      ≤ᵐ[arrayMeasure N]
      condExp (posFilt N p m n) (arrayMeasure N)
        (fun U : Array N => s.sup' hs (fun i => f i U)) := by
  have hmono : ∀ i ∈ s, condExp (posFilt N p m n) (arrayMeasure N) (f i)
      ≤ᵐ[arrayMeasure N] condExp (posFilt N p m n) (arrayMeasure N)
        (fun U : Array N => s.sup' hs (fun i => f i U)) := by
    intro i hi
    refine condExp_mono (hint i hi) hintsup (Filter.Eventually.of_forall fun U => ?_)
    exact Finset.le_sup' (fun i => f i U) hi
  have hall : ∀ᵐ U ∂(arrayMeasure N), ∀ i ∈ s,
      condExp (posFilt N p m n) (arrayMeasure N) (f i) U
        ≤ condExp (posFilt N p m n) (arrayMeasure N)
          (fun U : Array N => s.sup' hs (fun i => f i U)) U :=
    (Finset.eventually_all (I := s) (p := fun i U => condExp (posFilt N p m n) (arrayMeasure N) (f i) U
        ≤ condExp (posFilt N p m n) (arrayMeasure N)
          (fun U : Array N => s.sup' hs (fun i => f i U)) U)).mpr (fun i hi => hmono i hi)
  filter_upwards [hall] with U hU
  exact Finset.sup'_le hs _ (fun i hi => hU i hi)

/-! ### The conditional mean commutes with the finite average -/

theorem condExp_average (p : ℝ) (m : ℕ) (n : ℕ) {ι : Type*} (s : Finset ι) (hs : s.Nonempty)
    {f : ι → Array N → ℝ} (hint : ∀ i ∈ s, Integrable (f i) (arrayMeasure N)) :
    condExp (posFilt N p m n) (arrayMeasure N)
        (fun U : Array N => Swarming.Group.average s (fun i => f i U))
      =ᵐ[arrayMeasure N]
      fun U : Array N => Swarming.Group.average s
        (fun i => condExp (posFilt N p m n) (arrayMeasure N) (f i) U) := by
  haveI : IsProbabilityMeasure (arrayMeasure N) := arrayMeasure_isProbabilityMeasure N
  have hcard : ((s.card : ℕ) : ℝ) ≠ 0 := by
    have := Finset.card_pos.mpr hs
    exact_mod_cast (Nat.pos_iff_ne_zero.mp this)
  have hsum_eq : (∑ i ∈ s, f i) = (fun U : Array N => ∑ i ∈ s, f i U) := by
    funext U
    rw [Finset.sum_apply]
  have hsum : condExp (posFilt N p m n) (arrayMeasure N)
      (fun U : Array N => ∑ i ∈ s, f i U)
      =ᵐ[arrayMeasure N] fun U : Array N =>
        ∑ i ∈ s, condExp (posFilt N p m n) (arrayMeasure N) (f i) U := by
    have hsum_eq2 : (∑ i ∈ s, condExp (posFilt N p m n) (arrayMeasure N) (f i))
        = (fun U : Array N =>
            ∑ i ∈ s, condExp (posFilt N p m n) (arrayMeasure N) (f i) U) := by
      funext U
      rw [Finset.sum_apply]
    have h := condExp_finset_sum hint (posFilt N p m n)
    rw [hsum_eq, hsum_eq2] at h
    exact h
  have hfun : (fun U : Array N => Swarming.Group.average s (fun i => f i U))
      = fun U : Array N => ((s.card : ℕ) : ℝ)⁻¹ * ∑ i ∈ s, f i U := by
    funext U
    rw [Swarming.Group.average, div_eq_inv_mul]
  have hfun2 : (fun U : Array N => Swarming.Group.average s
        (fun i => condExp (posFilt N p m n) (arrayMeasure N) (f i) U))
      = fun U : Array N => ((s.card : ℕ) : ℝ)⁻¹ *
          ∑ i ∈ s, condExp (posFilt N p m n) (arrayMeasure N) (f i) U := by
    funext U
    rw [Swarming.Group.average, div_eq_inv_mul]
  rw [hfun, hfun2]
  have hc : (((s.card : ℕ) : ℝ))⁻¹ ≠ 0 := inv_ne_zero hcard
  have hsmul : condExp (posFilt N p m n) (arrayMeasure N)
      (fun U : Array N => (((s.card : ℕ) : ℝ))⁻¹ * ∑ i ∈ s, f i U)
      =ᵐ[arrayMeasure N] fun U : Array N =>
        (((s.card : ℕ) : ℝ))⁻¹ *
          condExp (posFilt N p m n) (arrayMeasure N) (fun U : Array N => ∑ i ∈ s, f i U) U := by
    have h := condExp_smul (𝕜 := ℝ) (μ := arrayMeasure N) (((s.card : ℕ) : ℝ))⁻¹
      (fun U : Array N => ∑ i ∈ s, f i U) (posFilt N p m n)
    have h1 : (((s.card : ℕ) : ℝ))⁻¹ • (fun U : Array N => ∑ i ∈ s, f i U)
        = fun U : Array N => (((s.card : ℕ) : ℝ))⁻¹ * ∑ i ∈ s, f i U := by
      funext U; rw [Pi.smul_apply, smul_eq_mul]
    have h2 : (((s.card : ℕ) : ℝ))⁻¹ •
          condExp (posFilt N p m n) (arrayMeasure N) (fun U : Array N => ∑ i ∈ s, f i U)
        = fun U : Array N => (((s.card : ℕ) : ℝ))⁻¹ *
            condExp (posFilt N p m n) (arrayMeasure N) (fun U : Array N => ∑ i ∈ s, f i U) U := by
      funext U; rw [Pi.smul_apply, smul_eq_mul]
    rw [h1, h2] at h
    exact h
  refine hsmul.trans ?_
  filter_upwards [hsum] with U hU
  simp only [Pi.mul_apply, hU]

end SwarmM3
